---
// Contact: split hero, directions and hours (with first-visit and social rows), and the booking
// band. The service-area towns live in the footer directly below. JSON-LD: ContactPage.
import landscape from '@/assets/placeholders/landscape.jpg';
import FormBand from '@/components/FormBand.astro';
import Hero from '@/components/Hero.astro';
import Photo from '@/components/Photo.astro';
import VisitBlock from '@/components/VisitBlock.astro';
import { site, bookOnPage } from '@/data/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { directionsUrl } from '@/lib/maps';
import { contactPageJsonLd } from '@/lib/structured-data';

const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const { address } = site;
const cityLine = `${address.city}, ${address.region} ${address.postalCode}`;
---

<BaseLayout
  title="Contact"
  description={`Visit ${site.name} at ${address.street}, ${cityLine}. Call ${site.phone.display} or book a free class.`}
  breadcrumbs={[{ label: 'Contact' }]}
  structuredData={[contactPageJsonLd(pageUrl, Astro.site!.origin)]}
>
  <Hero
    eyebrow={`Contact ${site.name}`}
    title="Come see the academy."
    accent="the academy."
    deck="We're in the Cromwell Field Shopping Center on Baltimore Annapolis Boulevard, next to Dunkin', with plenty of parking."
    primary={bookOnPage}
    secondary={{ label: 'Get directions', href: directionsUrl() }}
    facts={[address.street, cityLine]}
  >
    <Photo
      slot="media"
      src={landscape}
      alt="Placeholder photo of the academy"
      priority
      grade="mono"
      sizes="(min-width: 1024px) 60vw, 100vw"
      widths={[480, 800, 1200, 1600]}
    />
  </Hero>

  <VisitBlock tone="surface" heading="Directions & hours." accent="hours." detailed />

  <FormBand
    heading="Book a free class or ask us anything."
    accent="ask us anything."
    body="Fill this in and we'll be in touch shortly. Every class on the schedule is open to first-timers, and a clean gi is waiting for you."
  />
</BaseLayout>
