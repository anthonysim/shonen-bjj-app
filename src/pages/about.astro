---
// About, laid out like the original: split hero, the name's definition beside a statement, our
// story, what we stand for, the academy (features + gallery), community, the no-fees promise,
// one review, and the booking form. JSON-LD: an AboutPage whose main entity is the academy.
import landscape from '@/assets/placeholders/landscape.jpg';
import portrait from '@/assets/placeholders/portrait.jpg';
import square from '@/assets/placeholders/square.jpg';
import Button from '@/components/Button.astro';
import CredentialList from '@/components/CredentialList.astro';
import Definition from '@/components/Definition.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import FormBand from '@/components/FormBand.astro';
import Heading from '@/components/Heading.astro';
import Hero from '@/components/Hero.astro';
import LinkArrow from '@/components/LinkArrow.astro';
import NumberedRows from '@/components/NumberedRows.astro';
import Photo from '@/components/Photo.astro';
import PullQuote from '@/components/PullQuote.astro';
import ReviewsBlock from '@/components/ReviewsBlock.astro';
import Section from '@/components/Section.astro';
import SectionHead from '@/components/SectionHead.astro';
import { academyFeatures, nameDefinition, values } from '@/data/academy';
import { coach } from '@/data/coach';
import { featuredReviews, rating, reviewsFor } from '@/data/reviews';
import { site, bookOnPage } from '@/data/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { aboutPageJsonLd } from '@/lib/structured-data';

const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const [featured] = featuredReviews();
const [communityQuote] = reviewsFor('general', 2).slice(1);
const facts = [
  `${rating.score.toFixed(1)} ★ ${rating.source} · ${rating.count} reviews`,
  `${site.address.city}, ${site.address.region}`,
  'No sign-up fees',
];
const label = 'text-label font-medium tracking-[0.14em] text-muted uppercase';
const gutterX = 'gap-x-[clamp(1rem,2vw,2rem)]';
---

<BaseLayout
  title="About our academy"
  description={`${site.name}: ${site.tagline}. Detailed instruction, a spotless academy, and no sign-up fees.`}
  breadcrumbs={[{ label: 'About' }]}
  structuredData={[aboutPageJsonLd(pageUrl, Astro.site!.origin)]}
>
  <Hero
    eyebrow={`About ${site.name}`}
    title="A jiu jitsu academy that sweats the details."
    accent="sweats the details."
    deck="Shonen was built on a simple vision: world-class instruction that specializes in jiu jitsu, in a clean, organized academy where everyone is welcome."
    primary={bookOnPage}
    secondary={{ label: 'See class times', href: '/schedule' }}
    facts={facts}
  >
    <Photo
      slot="media"
      src={landscape}
      alt="Placeholder photo of an evening adult class"
      priority
      grade="mono"
      sizes="(min-width: 1024px) 60vw, 100vw"
      widths={[480, 800, 1200, 1600]}
    />
  </Hero>

  <Section id="the-name">
    <div class:list={['grid gap-12 lg:grid-cols-12 lg:gap-y-16', gutterX]}>
      <Definition {...nameDefinition} class="lg:col-start-1 lg:col-end-7" />
      <div class="lg:col-start-8 lg:col-end-13 lg:self-end">
        <Heading
          text="At Shonen, you become the hero of your own story."
          accent="your own story."
        />
        <p class="mt-6">
          In a shōnen story, the hero doesn't start out strong. They train, they get knocked down
          and they get back up a little better every time. That's jiu jitsu. Every class asks for a
          little self-perfection and a little self-discipline, and gives back a team that shows up
          for each other, on the mat and off it.
        </p>
      </div>
    </div>
  </Section>

  <Section tone="surface" id="story">
    <div class:list={['grid items-center gap-12 lg:grid-cols-12', gutterX]}>
      <div class="lg:col-start-7 lg:col-end-13 lg:row-start-1">
        <Eyebrow>Our story</Eyebrow>
        <Heading text="From Costa Mesa to Glen Burnie." accent="Glen Burnie." class="mt-4" />
        <div class="mt-6 max-w-[60ch] space-y-4">
          <p>
            {coach.displayName} earned his black belt under the legendary Mendes Brothers and taught
            kids and adults at their Art of Jiu Jitsu Academy in Costa Mesa, California, one of the
            most respected academies in the sport. As a coach there, he was part of five IBJJF Kids
            Pan American team titles.
          </p>
          <p>
            He brought that same curriculum, and the same standard, to Maryland. Shonen was built to
            offer world-class instruction that specializes in jiu jitsu, instead of following the
            trend of being a sub-par MMA school. Every class is organized, supervised and taught
            with the same attention to detail, whether it’s your first day or your hundredth.
          </p>
        </div>
        <LinkArrow href={`/team/${coach.slug}`} class="mt-6 text-ink">
          Meet the Coach
        </LinkArrow>
      </div>
      <figure class="md:max-w-[32.5rem] lg:col-start-1 lg:col-end-6 lg:row-start-1 lg:max-w-none">
        <div class="aspect-4/5 overflow-hidden bg-paper-2">
          <Photo
            src={portrait}
            alt="Placeholder photo of black belts in a studio portrait"
            grade="mono"
            sizes="(min-width: 1024px) 40vw, (min-width: 768px) 520px, 100vw"
            widths={[480, 720, 1000]}
            class="h-full object-cover"
          />
        </div>
        <figcaption class:list={[label, 'mt-2']}>Lineage matters</figcaption>
      </figure>
    </div>
  </Section>

  <Section id="values">
    <SectionHead
      eyebrow="What we believe"
      heading="What we stand for."
      accent="stand for."
      lede="Three words have guided Shonen since the day the doors opened, and they still decide how every class is run."
    />
    <NumberedRows items={values} />
  </Section>

  <Section tone="surface" id="academy">
    <div class:list={['mb-24 grid gap-12 lg:grid-cols-12', gutterX]}>
      <header class="lg:col-start-1 lg:col-end-6">
        <Eyebrow>The academy</Eyebrow>
        <Heading
          text="Built for training, kept immaculate."
          accent="kept immaculate."
          class="mt-4"
        />
        <p class="mt-6 max-w-[56ch] text-lede">
          Members mention it in review after review: the academy is spotless. It’s the first detail
          you’ll notice when you walk in.
        </p>
      </header>
      <CredentialList items={academyFeatures} class="lg:col-start-7 lg:col-end-13" />
    </div>
    {/* Swipeable row on phones; three equal photos side by side from lg */}
    <div class="-mx-(--spacing-gutter) grid snap-x snap-mandatory auto-cols-[78%] grid-flow-col gap-3 overflow-x-auto scroll-px-(--spacing-gutter) px-(--spacing-gutter) pb-3 lg:mx-0 lg:grid-flow-row lg:grid-cols-3 lg:gap-[clamp(1rem,2vw,2rem)] lg:overflow-visible lg:p-0">
      {[portrait, square, landscape].map((image) => (
        <div class="aspect-4/5 snap-start overflow-hidden bg-paper-2">
          <Photo
            src={image}
            alt="Placeholder photo of the academy"
            grade="mono"
            sizes="(min-width: 1024px) 33vw, 78vw"
            widths={[320, 480, 720]}
            class="h-full object-cover"
          />
        </div>
      ))}
    </div>
  </Section>

  <Section id="community">
    <SectionHead
      eyebrow="Community"
      heading="Beginners and competitors, one team."
      accent="one team."
      lede="From four-year-olds on their first day to competitors preparing for IBJJF events, everyone in Glen Burnie trains in the same room, with the same respect."
    />
    <figure>
      <div class="aspect-3/2 overflow-hidden bg-paper-2">
        <Photo
          src={landscape}
          alt="Placeholder photo of the whole team together"
          grade="mono"
          sizes="(min-width: 1536px) 84vw, (min-width: 1376px) 1280px, 100vw"
          widths={[640, 960, 1280, 1600, 2560]}
          class="h-full object-cover"
        />
      </div>
      <figcaption class:list={[label, 'mt-2']}>The Shonen kids team</figcaption>
    </figure>
    {communityQuote ? (
      <PullQuote
        quote={communityQuote.quote}
        author={communityQuote.author}
        label="Google review"
        class="mt-16 ml-auto max-w-[47.5rem]"
      />
    ) : null}
  </Section>

  <Section tone="surface" id="promise" containerClass="[--page-max:47.5rem] text-center">
    <Eyebrow>Our promise</Eyebrow>
    <Heading text="No sign-up fees. Ever." accent="Ever." class="mt-4" />
    <p class="mx-auto mt-6 max-w-[56ch] text-lede">
      Sign-up fees and other hidden fees are a common practice in martial arts schools. There are no
      sign-up fees at Shonen, and no belt-promotion fees either.
    </p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-x-6 gap-y-4">
      <Button href="#book" arrow>
        Book a free class
      </Button>
      <LinkArrow href="/faq" class="text-ink">
        Read the FAQ
      </LinkArrow>
    </div>
  </Section>

  {featured ? (
    <ReviewsBlock
      reviews={[featured]}
      eyebrow="Reviews"
      heading="Details matter."
      accent="matter."
      tone="paper"
    />
  ) : null}

  <FormBand />
</BaseLayout>
