---
// Where the booking form lands without JavaScript after a successful request. Not indexed.
import Button from '@/components/Button.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import Heading from '@/components/Heading.astro';
import Section from '@/components/Section.astro';
import { site } from '@/data/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Thanks, we got your request" noindex>
  <Section containerClass="[--page-max:47.5rem] text-center">
    <Eyebrow>Your first class is free</Eyebrow>
    <Heading
      level={1}
      size="xl"
      text="Thanks. We'll text you shortly."
      accent="shortly."
      class="mt-4"
    />
    <p class="mx-auto mt-6 max-w-[52ch] text-lede">
      We'll text you to lock in a time for your free class. Arrive 15 minutes early to meet the
      staff, sign a quick waiver and take a tour.
    </p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-x-6 gap-y-4">
      <Button href="/schedule" arrow>
        See the schedule
      </Button>
      <Button href={site.phone.href} variant="secondary">
        Call {site.phone.display}
      </Button>
    </div>
  </Section>
</BaseLayout>
