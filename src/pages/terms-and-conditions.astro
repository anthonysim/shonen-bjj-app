---
import LegalPage from '@/components/LegalPage.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { withHome } from '@/lib/structured-data';
import { getEntry } from 'astro:content';

const entry = (await getEntry('legal', 'terms-and-conditions'))!;
const breadcrumbs = [{ label: 'Terms & conditions' }];
---

<BaseLayout title={entry.data.title} description={entry.data.summary} breadcrumbs={breadcrumbs}>
  <LegalPage entry={entry} crumbs={withHome(breadcrumbs)} />
</BaseLayout>
