---
import landscape from '@/assets/placeholders/landscape.jpg';
import Button from '@/components/Button.astro';
import CtaBand from '@/components/CtaBand.astro';
import FaqList from '@/components/FaqList.astro';
import FormBand from '@/components/FormBand.astro';
import Hero from '@/components/Hero.astro';
import NumberedCards from '@/components/NumberedCards.astro';
import NumberedSteps from '@/components/NumberedSteps.astro';
import Photo from '@/components/Photo.astro';
import ReviewsBlock from '@/components/ReviewsBlock.astro';
import VisitBlock from '@/components/VisitBlock.astro';
import { faqsFor } from '@/data/faqs';
import { reviewsFor } from '@/data/reviews';
import Eyebrow from '@/components/Eyebrow.astro';
import Heading from '@/components/Heading.astro';
import Section from '@/components/Section.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';

const swatches = [
  ['ink', 'bg-ink'],
  ['ink-soft', 'bg-ink-soft'],
  ['body', 'bg-body'],
  ['muted', 'bg-muted'],
  ['paper', 'bg-paper'],
  ['paper-2', 'bg-paper-2'],
  ['surface', 'bg-surface'],
  ['line-strong', 'bg-line-strong'],
  ['error', 'bg-error'],
] as const;

const tones = ['paper', 'surface', 'dark'] as const;
---

<BaseLayout title="Styleguide" noindex breadcrumbs={[{ label: 'Styleguide' }]}>
  <Section>
    <Eyebrow>Internal</Eyebrow>
    <Heading level={1} size="display" text="Styleguide" accent="guide" class="mt-2" />
    <p class="text-muted mt-4 max-w-prose">
      Every primitive at every width. Not indexed, not in the sitemap.
    </p>
  </Section>

  <Section tone="surface">
    <Heading text="Color tokens" accent="Color" />
    <ul class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5">
      {swatches.map(([name, cls]) => (
        <li>
          <div class:list={['border-line h-16 rounded-card border', cls]} />
          <p class="mt-2 text-sm">{name}</p>
        </li>
      ))}
    </ul>
  </Section>

  <Section>
    <Heading text="Headings" accent="Headings" />
    <div class="mt-8 space-y-6">
      <Heading level={3} size="display" text="Display heading" accent="Display" />
      <Heading level={3} size="xl" text="Extra large heading" accent="large" />
      <Heading level={3} size="lg" text="Large heading" accent="Large" />
      <Heading level={3} size="md" text="Medium heading, no accent" />
    </div>
    <p class="mt-8 max-w-prose text-base md:text-lg">
      Body copy in Inter at 16px on phones and 18px from <code>md</code>. Inputs stay 16px or larger
      so iOS doesn't zoom on focus.
    </p>
  </Section>

  <Section tone="surface">
    <Heading text="Buttons" accent="Buttons" />
    <div class="mt-8 flex flex-wrap gap-3">
      <Button href="#">Primary</Button>
      <Button href="#" variant="secondary">
        Secondary
      </Button>
      <Button href="#" variant="ghost">
        Ghost
      </Button>
      <Button size="lg" href="#">
        Large primary
      </Button>
      <Button type="button" disabled>
        Disabled
      </Button>
    </div>
  </Section>

  {tones.map((tone) => (
    <Section tone={tone}>
      <Eyebrow>Section tone</Eyebrow>
      <Heading text={`Tone: ${tone}`} accent={tone} class="mt-2" />
      <div class="mt-6 flex flex-wrap gap-3">
        <Button href="#" variant={tone === 'dark' ? 'inverse' : 'primary'}>
          Book a free class
        </Button>
        <Button href="#" variant="secondary">
          See class times
        </Button>
      </div>
    </Section>
  ))}

  <Hero
    eyebrow="Hero with media"
    title="Become the hero of your story"
    accent="hero"
    deck="Eyebrow, accent heading, deck, two CTAs, a fact strip, and a photo."
    primary={{ label: 'Book a free class', href: '#' }}
    secondary={{ label: 'See class times', href: '#' }}
    facts={['5.0 stars', 'Ages 4 and up', 'First class free']}
  >
    <Photo slot="media" src={landscape} alt="Placeholder photo" priority />
  </Hero>

  <Hero
    eyebrow="Hero without media"
    title="Text-only hero"
    accent="Text-only"
    deck="Without a photo the text column widens to nine columns."
    primary={{ label: 'Book a free class', href: '#' }}
    secondary={{ label: 'See class times', href: '#' }}
    facts={['Fact one', 'Fact two', 'Fact three']}
  />

  <Section tone="surface">
    <Heading text="Numbered cards" accent="cards" />
    <div class="mt-8">
      <NumberedCards
        items={[
          { title: 'Confidence', body: 'Kids learn to handle challenges calmly.' },
          { title: 'Fitness', body: 'A full-body workout that feels like play.' },
          { title: 'Focus', body: 'Listening and following instructions.' },
          { title: 'Friends', body: 'A supportive crew on and off the mats.' },
        ]}
      />
    </div>
  </Section>

  <Section>
    <Heading text="Numbered steps" accent="steps" />
    <div class="mt-8 max-w-2xl">
      <NumberedSteps
        items={[
          { title: 'Pick a class', body: 'Choose a time that works and we will confirm by text.' },
          { title: 'Arrive early', body: 'Come 15 minutes before class to get settled.' },
          { title: 'Train at your pace', body: 'Coaches guide you through everything.' },
        ]}
      />
    </div>
  </Section>

  <ReviewsBlock reviews={reviewsFor('kids', 3)} />

  <Section>
    <Heading text="FAQ list" accent="FAQ" />
    <div class="mt-8 max-w-3xl">
      <FaqList items={faqsFor('kids')} />
    </div>
  </Section>

  <VisitBlock tone="surface" />

  <FormBand defaultProgram="kids" />

  <CtaBand
    heading="Ready to start?"
    accent="start"
    body="Your first class is free. No sign-up fees."
    primary={{ label: 'Book a free class', href: '#' }}
    secondary={{ label: 'Call us', href: '#' }}
  />
</BaseLayout>
