---
// Meet the Coach, laid out like the original's profile page: split hero, the story in a narrow
// column with a drop cap and a pull quote, the competition record beside a sticky photo, lineage,
// reviews, and the booking form. JSON-LD: a ProfilePage whose main entity is the coach.
import landscape from '@/assets/placeholders/landscape.jpg';
import portrait from '@/assets/placeholders/portrait.jpg';
import square from '@/assets/placeholders/square.jpg';
import CredentialList from '@/components/CredentialList.astro';
import CtaBand from '@/components/CtaBand.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import Heading from '@/components/Heading.astro';
import Hero from '@/components/Hero.astro';
import LinkArrow from '@/components/LinkArrow.astro';
import Photo from '@/components/Photo.astro';
import ReviewsBlock from '@/components/ReviewsBlock.astro';
import Section from '@/components/Section.astro';
import SectionHead from '@/components/SectionHead.astro';
import { coach } from '@/data/coach';
import { reviewsFor } from '@/data/reviews';
import { site } from '@/data/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { coachProfileJsonLd } from '@/lib/structured-data';
import { accentTail } from '@/lib/text';

const { firstName } = coach;
const [lead, ...restOfBio] = coach.bio;
const quote = accentTail(coach.pullQuote, coach.pullQuoteAccent);

const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const profile = coachProfileJsonLd(
  pageUrl,
  Astro.site!.origin,
  new URL(portrait.src, Astro.site).href,
);

const label = 'text-label font-medium tracking-[0.14em] text-muted uppercase';
---

<BaseLayout
  title={`${coach.displayName}, BJJ Black Belt`}
  description={`${coach.displayName}: ${coach.intro}`}
  breadcrumbs={[{ label: 'Meet the Coach' }]}
  structuredData={[profile]}
>
  <Hero
    eyebrow="Meet the Coach"
    title={coach.displayName}
    accent={coach.accent}
    deck={coach.intro}
    primary={{ label: `Book a class with ${firstName}`, href: site.cta.href }}
    secondary={{ label: 'The competition record', href: '#record' }}
    facts={coach.facts}
  >
    <Photo
      slot="media"
      src={portrait}
      alt={`Placeholder portrait of ${coach.displayName}`}
      priority
      grade="mono"
      sizes="(min-width: 1024px) 60vw, 100vw"
      widths={[480, 800, 1200, 1600]}
    />
  </Hero>

  <Section tone="surface" id="story" containerClass="[--page-max:47.5rem]">
    <Eyebrow>The story</Eyebrow>
    <Heading text="A teacher who still competes." accent="still competes." class="mt-4 mb-12" />
    <div class="space-y-[1.1em]">
      <p class="first-letter:float-left first-letter:mt-[0.08em] first-letter:mr-[0.1em] first-letter:font-display first-letter:text-[4.4em] first-letter:leading-[0.82] first-letter:font-light first-letter:text-ink">
        {lead}
      </p>
      {restOfBio.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </div>
    <figure class="mt-[clamp(3.5rem,7vw,7rem)] border-y border-line py-[clamp(2rem,4vw,3.5rem)] text-center">
      <blockquote>
        <p class="mx-auto max-w-[20ch] font-display text-h2 font-light text-balance text-ink">
          {quote ? (
            <>
              {quote.before}
              <em class="italic">{quote.accent}</em>
              {quote.after}
            </>
          ) : (
            coach.pullQuote
          )}
        </p>
      </blockquote>
    </figure>
  </Section>

  <Section id="record">
    <SectionHead
      eyebrow="On the competition mat"
      heading="A record earned at the highest level."
      accent="at the highest level."
      lede={`${coach.shortName} still competes as an IBJJF black belt, so what he teaches in class has been tested against the best in the world.`}
    />
    <div class="grid items-start gap-16 lg:grid-cols-12 lg:gap-x-[clamp(1rem,2vw,2rem)]">
      <figure class="md:max-w-[32.5rem] lg:sticky lg:top-[calc(var(--spacing-header)+2rem)] lg:col-start-1 lg:col-end-6 lg:max-w-none">
        <div class="aspect-square overflow-hidden bg-paper-2">
          <Photo
            src={square}
            alt="Placeholder photo of a competition match"
            grade="mono"
            sizes="(min-width: 1024px) 40vw, (min-width: 768px) 520px, 100vw"
            widths={[480, 720, 1000]}
            class="h-full object-cover"
          />
        </div>
        <figcaption class:list={[label, 'mt-2']}>IBJJF, no-gi</figcaption>
      </figure>
      <div class="grid gap-16 lg:col-start-7 lg:col-end-13">
        <div>
          <h3 class:list={[label, 'mb-2']}>Competition achievements</h3>
          <CredentialList items={coach.competitionRecord} />
        </div>
        <div>
          <h3 class:list={[label, 'mb-2']}>Professional achievements</h3>
          <CredentialList items={coach.professional} />
        </div>
      </div>
    </div>
  </Section>

  <Section tone="surface" id="lineage">
    <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-x-[clamp(1rem,2vw,2rem)]">
      <div class="lg:col-start-7 lg:col-end-13 lg:row-start-1">
        <Eyebrow>Lineage</Eyebrow>
        <Heading text="Modern, detailed, technical." accent="technical." class="mt-4" />
        <div class="mt-6 max-w-[60ch] space-y-4">
          {coach.lineage.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
        <LinkArrow href="/programs" class="mt-6 text-ink">
          Explore the programs
        </LinkArrow>
      </div>
      <figure class="md:max-w-[32.5rem] lg:col-start-1 lg:col-end-6 lg:row-start-1 lg:max-w-none">
        <div class="aspect-4/5 overflow-hidden bg-paper-2">
          <Photo
            src={landscape}
            alt="Placeholder photo of black belts in a studio portrait"
            grade="mono"
            sizes="(min-width: 1024px) 40vw, (min-width: 768px) 520px, 100vw"
            widths={[480, 720, 1000]}
            class="h-full object-cover"
          />
        </div>
        <figcaption class:list={[label, 'mt-2']}>Art of Jiu Jitsu lineage</figcaption>
      </figure>
    </div>
  </Section>

  <ReviewsBlock
    reviews={reviewsFor('coach')}
    eyebrow="What students say"
    heading="Taught with uncommon detail."
    accent="uncommon detail."
    tone="paper"
  />

  <CtaBand
    heading={`Train with ${coach.shortName}.`}
    accent={`${coach.shortName}.`}
    body="Every class on the schedule is open to first-timers, kids and adults, and a clean gi is waiting for you."
    primary={site.cta}
    secondary={{ label: 'See class times', href: '/schedule' }}
  />
</BaseLayout>
