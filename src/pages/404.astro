---
import Button from '@/components/Button.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found">
  <section class="page-container [--page-max:48rem] py-[clamp(4.5rem,4rem+6vw,9.5rem)]">
    <h1 class="text-h1">Page not found</h1>
    <p class="mt-4 text-base md:text-lg">That page doesn't exist or has moved.</p>
    <Button href="/" arrow class="mt-6">
      Back to home
    </Button>
  </section>
</BaseLayout>
