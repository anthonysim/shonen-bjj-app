---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found">
  <section class="mx-auto max-w-3xl px-4 py-12 md:px-8 md:py-20">
    <h1 class="text-3xl font-bold md:text-5xl">Page not found</h1>
    <p class="mt-4 text-base md:text-lg">That page doesn't exist or has moved.</p>
    <a
      href="/"
      class="bg-brand-600 hover:bg-brand-900 mt-6 inline-flex min-h-11 items-center rounded-md px-4 font-semibold text-white"
    >
      Back to home
    </a>
  </section>
</BaseLayout>
