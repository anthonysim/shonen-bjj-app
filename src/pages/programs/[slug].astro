---
import PageStub from '@/components/PageStub.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { programs } from '@/data/site';

export function getStaticPaths() {
  // getStaticPaths runs in isolation: keep this list inside the function.
  const DEDICATED_PAGES = ['kids'];

  // Programs with their own page (e.g. kids.astro) are excluded until every program has one,
  // then this file goes away.
  return programs
    .filter((program) => !DEDICATED_PAGES.includes(program.slug))
    .map((program) => ({ params: { slug: program.slug }, props: { program } }));
}

const { program } = Astro.props;
---

<BaseLayout
  title={program.name}
  description={program.blurb}
  breadcrumbs={[{ label: 'Programs', href: '/programs' }, { label: program.name }]}
>
  <PageStub title={`${program.name} (${program.ages})`} intro={program.blurb} />
</BaseLayout>
