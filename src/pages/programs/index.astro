---
import landscape from '@/assets/placeholders/landscape.jpg';
import portrait from '@/assets/placeholders/portrait.jpg';
import square from '@/assets/placeholders/square.jpg';
import Button from '@/components/Button.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import FormBand from '@/components/FormBand.astro';
import Hero from '@/components/Hero.astro';
import NumberedRows from '@/components/NumberedRows.astro';
import Photo from '@/components/Photo.astro';
import ProgramCard from '@/components/ProgramCard.astro';
import ProgramRow from '@/components/ProgramRow.astro';
import QuoteSolo from '@/components/QuoteSolo.astro';
import Section from '@/components/Section.astro';
import SectionHead from '@/components/SectionHead.astro';
import { pathway } from '@/data/academy';
import { rating, reviewsById } from '@/data/reviews';
import { bookOnPage, programCards, site } from '@/data/site';
import BaseLayout from '@/layouts/BaseLayout.astro';

// Four cards in the grid; birthday parties get the row underneath, like the original
const classCards = programCards.filter((card) => card.id !== 'birthday-parties');
const birthday = programCards.find((card) => card.id === 'birthday-parties')!;
const cardImages = [portrait, square, landscape, portrait];
const [review] = reviewsById(['general-brent']);
---

<BaseLayout
  title="Programs"
  description="Kids, adults, and no-gi jiu-jitsu classes, plus birthday parties. Find the right class and book your first one free."
  breadcrumbs={[{ label: 'Programs' }]}
>
  <Hero
    eyebrow={`Jiu Jitsu programs · ${site.address.city}, ${site.address.region}`}
    title="Training for every stage."
    accent="every stage."
    deck="From four-year-olds learning to tumble to competitors chasing black belt, every student trains with partners their own size, in a class built for them."
    primary={bookOnPage}
    secondary={{ label: 'See class times', href: '/schedule' }}
    facts={[
      `${rating.score.toFixed(1)} ★ ${rating.source} · ${rating.count} reviews`,
      'Ages 4 to adult',
      'First class free',
    ]}
  >
    <Photo
      slot="media"
      src={landscape}
      alt="Placeholder photo of students training"
      priority
      sizes="(min-width: 1024px) 60vw, 100vw"
      widths={[480, 800, 1200, 1600]}
    />
  </Hero>

  <Section tone="surface" id="classes">
    <SectionHead
      eyebrow="Our programs"
      heading="Four paths, one standard."
      accent="one standard."
      lede="Classes are grouped by age, so every student trains with partners their own size. The first class is always free."
    />
    <ul class="grid grid-cols-2 gap-x-3 gap-y-8 sm:gap-x-[clamp(1rem,2vw,2rem)] sm:gap-y-12 xl:grid-cols-4">
      {classCards.map((card, index) => (
        <li class="flex">
          <ProgramCard
            card={card}
            index={index}
            image={cardImages[index % cardImages.length]}
            class="w-full"
          />
        </li>
      ))}
    </ul>

    <div class="mt-[clamp(2.5rem,5vw,4.5rem)] grid items-stretch gap-8 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:gap-[clamp(1rem,2vw,2rem)]">
      <ProgramRow
        href={birthday.href}
        label={`${birthday.ages} · Vol. 05`}
        title={`${birthday.name} on the mat`}
        accent="on the mat"
        image={landscape}
      />
      <aside
        data-reveal
        aria-labelledby="place-title"
        class="rounded-card bg-ink p-[clamp(1.5rem,3vw,2.5rem)] text-white [--heading:#fff] lg:row-span-2 lg:col-start-2 lg:row-start-1"
      >
        <Eyebrow class="text-white/55">Not sure?</Eyebrow>
        <h3 id="place-title" class="mt-3 text-h2">
          Not sure where to start? <em class="italic">We’ll place you.</em>
        </h3>
        <p class="mt-4 text-white/72">
          Tell us a little about you or your child and we’ll recommend the right class. Every class
          on the schedule is open to first-timers.
        </p>
        <Button href="#book" variant="inverse" arrow class="mt-6">
          Get a recommendation
        </Button>
      </aside>
    </div>
  </Section>

  <Section id="pathway">
    <SectionHead
      eyebrow="The pathway"
      heading="How the classes fit together."
      accent="fit together."
      lede="Each class is built for a stage of the journey. Students move up as they grow, and adults progress from fundamentals to the full game at their own pace."
    />
    <NumberedRows items={pathway} />
  </Section>

  {review ? <QuoteSolo review={review} tone="surface" readAll /> : null}

  <FormBand />
</BaseLayout>
