---
import landscape from '@/assets/placeholders/landscape.jpg';
import portrait from '@/assets/placeholders/portrait.jpg';
import square from '@/assets/placeholders/square.jpg';
import AgeGroupCard from '@/components/AgeGroupCard.astro';
import Button from '@/components/Button.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import FaqSection from '@/components/FaqSection.astro';
import FormBand from '@/components/FormBand.astro';
import Heading from '@/components/Heading.astro';
import Hero from '@/components/Hero.astro';
import LinkArrow from '@/components/LinkArrow.astro';
import MiniCoachCard from '@/components/MiniCoachCard.astro';
import NumberedRows from '@/components/NumberedRows.astro';
import Photo from '@/components/Photo.astro';
import ReviewsBlock from '@/components/ReviewsBlock.astro';
import Section from '@/components/Section.astro';
import SectionHead from '@/components/SectionHead.astro';
import VideoBlock from '@/components/VideoBlock.astro';
import { faqsFor } from '@/data/faqs';
import { classSteps, parentNote, safetyPoints, whyJiuJitsu } from '@/data/kids';
import { reviewsFor } from '@/data/reviews';
import { classesForAgeGroup, friendlyWhen, schedule } from '@/data/schedule';
import { programs, site } from '@/data/site';
import BaseLayout from '@/layouts/BaseLayout.astro';

const kids = programs.find((program) => program.slug === 'kids')!;
const ageGroups = kids.ageGroups ?? [];
const groupImages = [landscape, square];
// "Tuesday & Thursday 5:00 PM · Saturday 9:00 AM", for the line under the age cards
const kidsDays = friendlyWhen(
  schedule.filter((cls) => cls.category === 'kids'),
  { long: true },
);
---

<BaseLayout
  title="Kids jiu-jitsu (ages 4-13)"
  description="Playful, structured jiu-jitsu classes for kids ages 4 to 13. Build confidence, focus, and fitness. First class free."
  breadcrumbs={[{ label: 'Programs', href: '/programs' }, { label: 'Kids' }]}
>
  <Hero
    eyebrow={`Kids Brazilian Jiu Jitsu · Ages 4–13 · ${site.address.city}`}
    title="Confidence that carries off the mat."
    accent="off the mat."
    deck="Our kids learn to stay calm under pressure, escape bad positions and handle a bully without throwing a punch, led by a black belt who helped coach five IBJJF Kids Pan American team titles."
    primary={{ label: 'Book a free kids class', href: '#book' }}
    secondary={{ label: 'Class times', href: '#age-groups' }}
    facts={kids.facts}
  >
    <Photo
      slot="media"
      src={landscape}
      alt="Placeholder photo of kids training"
      priority
      sizes="(min-width: 1024px) 60vw, 100vw"
      widths={[480, 800, 1200, 1600]}
    />
  </Hero>

  <Section tone="surface" id="age-groups">
    <SectionHead
      eyebrow="Two age groups"
      heading="The right class for their age."
      accent="their age."
      lede="Every child trains with partners close to their age and size. Both groups train at the same times, so brothers and sisters can come together."
    />
    <div class="grid gap-12 sm:grid-cols-2 sm:gap-x-[clamp(16px,2vw,32px)]">
      {ageGroups.map((group, index) => (
        <AgeGroupCard
          group={group}
          image={groupImages[index % groupImages.length]}
          when={friendlyWhen(classesForAgeGroup(group.id))}
        />
      ))}
    </div>
    <div class="mt-12 flex flex-col gap-6 border-t border-line pt-8 sm:flex-row sm:items-center sm:justify-between">
      <Eyebrow>{kidsDays}</Eyebrow>
      <div class="flex flex-wrap items-center gap-x-6 gap-y-4">
        <Button href="#book" arrow>
          Book a free kids class
        </Button>
        <LinkArrow href="/schedule" class="text-ink">
          Full schedule
        </LinkArrow>
      </div>
    </div>
  </Section>

  <Section id="why">
    <SectionHead
      eyebrow="Why jiu jitsu"
      heading="Why jiu jitsu over other martial arts?"
      accent="other martial arts?"
      lede="Jiu jitsu focuses on controlling situations as safely as possible. Without punches or kicks to the head, kids can practise against fully resisting partners safely, so if someone ever puts their hands on them, it won’t be the first time."
    />
    <div class="grid items-start gap-12 min-[1100px]:grid-cols-[minmax(0,8fr)_minmax(0,4fr)] min-[1100px]:gap-[clamp(32px,5vw,96px)]">
      <NumberedRows items={whyJiuJitsu} />
      <div class="max-h-[70svh] overflow-hidden bg-paper-2 min-[1100px]:sticky min-[1100px]:top-[calc(var(--spacing-header)+32px)] min-[1100px]:max-h-none">
        <Photo
          src={portrait}
          alt="Placeholder photo of kids drilling a technique"
          grade="soft"
          sizes="(min-width: 1100px) 30vw, 100vw"
          widths={[480, 720, 960]}
          class="aspect-4/5 h-full object-cover"
        />
      </div>
    </div>
  </Section>

  <Section tone="surface" id="inside-a-class">
    <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-x-[clamp(16px,2vw,32px)]">
      <div class="lg:col-start-7 lg:col-end-13 lg:row-start-1">
        <Eyebrow>Inside a class</Eyebrow>
        <Heading text="What a kids class looks like." accent="looks like." class="mt-4" />
        <p class="mt-6 max-w-[56ch] text-lede">
          Forty-five minutes, structured from the first warm-up to the final game.
        </p>
        <NumberedRows items={classSteps} compact class="mt-8" />
        <p class="mt-6 text-muted">{parentNote}</p>
      </div>
      <div class="aspect-4/5 overflow-hidden bg-paper-2 lg:col-start-1 lg:col-end-6 lg:row-start-1">
        <Photo
          src={square}
          alt="Placeholder photo of a kids class in progress"
          grade="soft"
          sizes="(min-width: 1024px) 40vw, 100vw"
          widths={[480, 720, 1000]}
          class="h-full object-cover"
        />
      </div>
    </div>
  </Section>

  <Section id="safety">
    <div class="grid items-center gap-16 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-[clamp(32px,6vw,112px)]">
      <div>
        <Eyebrow>Parents ask us</Eyebrow>
        <Heading text="Safe, clean and well supervised." accent="well supervised." class="mt-4" />
        <ul class="mt-8">
          {safetyPoints.map((point) => (
            <li class="relative border-t border-line py-4 pl-8 last:border-b before:absolute before:left-0 before:text-muted before:content-['—']">
              {point}
            </li>
          ))}
        </ul>
      </div>
      <div class="grid grid-cols-2 items-start gap-x-[clamp(16px,2vw,32px)]">
        {[portrait, landscape].map((image, index) => (
          <div
            class:list={['aspect-4/5 overflow-hidden bg-paper-2', index === 1 && 'mt-16 lg:mt-32']}
          >
            <Photo
              src={image}
              alt=""
              grade="soft"
              sizes="(min-width: 1024px) 25vw, 50vw"
              widths={[320, 480, 640]}
              class="h-full object-cover"
            />
          </div>
        ))}
      </div>
    </div>
  </Section>

  <ReviewsBlock
    reviews={reviewsFor('kids', 3)}
    heading="What parents say."
    accent="say."
    tone="surface"
  />

  <Section id="watch">
    <div class="grid items-center gap-16 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:gap-[clamp(32px,6vw,112px)]">
      <div>
        <Eyebrow>Watch a class</Eyebrow>
        <Heading text="See a kids class in action." accent="in action." class="mt-4" />
        <p class="mt-6 max-w-[56ch] text-lede">
          Agility drills, belt tying, big grins and real technique, filmed in a Shonen kids class
          right here in Glen Burnie. The best way to see it is in person, and the first class is
          free.
        </p>
        <div class="mt-8">
          <Button href="#book" arrow>
            Book a free kids class
          </Button>
        </div>
        <MiniCoachCard
          note="Kids classes are overseen by a Mendes Brothers black belt and former Art of Jiu Jitsu kids instructor."
          class="mt-12"
        />
      </div>
      <VideoBlock
        poster={landscape}
        sources={[{ src: '/videos/placeholder-hero.webm', type: 'video/webm' }]}
        title="A kids class at the academy (placeholder video)"
        caption="Watch a kids class (0:04)"
      />
    </div>
  </Section>

  <FaqSection items={faqsFor('kids')} heading="Questions parents ask." accent="ask." />

  <FormBand
    heading="Their first class is on us."
    accent="on us."
    body="Pick a program and we'll text you to lock in a time. Every class on the schedule is open to first-timers, and a clean gi will be waiting for your child."
    defaultProgram="kids"
  />
</BaseLayout>
