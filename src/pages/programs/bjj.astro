---
import landscape from '@/assets/placeholders/landscape.jpg';
import portrait from '@/assets/placeholders/portrait.jpg';
import square from '@/assets/placeholders/square.jpg';
import CoachSpotlight from '@/components/CoachSpotlight.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import FaqSection from '@/components/FaqSection.astro';
import FormBand from '@/components/FormBand.astro';
import Heading from '@/components/Heading.astro';
import Hero from '@/components/Hero.astro';
import NumberedRows from '@/components/NumberedRows.astro';
import Photo from '@/components/Photo.astro';
import ProgramRow from '@/components/ProgramRow.astro';
import PullQuote from '@/components/PullQuote.astro';
import Section from '@/components/Section.astro';
import SectionHead from '@/components/SectionHead.astro';
import TrackCard from '@/components/TrackCard.astro';
import { adultClassSteps, neverTrained, tracks, womens } from '@/data/adults';
import { faqsFor } from '@/data/faqs';
import { reviewLabel, reviewsFor } from '@/data/reviews';
import { friendlyWhen, schedule } from '@/data/schedule';
import { programCards, programs, site } from '@/data/site';
import BaseLayout from '@/layouts/BaseLayout.astro';

const adults = programs.find((program) => program.slug === 'bjj')!;
const noGiCard = programCards.find((card) => card.id === 'no-gi')!;
const [firstQuote, secondQuote] = reviewsFor('adults', 2);
const noGiWhen = friendlyWhen(schedule.filter((cls) => cls.category === 'no-gi'));
const [womensQuote] = reviewsFor('general', 2).slice(1);
---

<BaseLayout
  title="Adult jiu-jitsu (ages 14+)"
  description="Gi classes for adults and teens 14 and up, from your very first day to competition. Your first class is free."
  breadcrumbs={[{ label: 'Programs', href: '/programs' }, { label: 'Adults' }]}
>
  <Hero
    eyebrow={`Adult Brazilian Jiu Jitsu · Ages 14+ · ${site.address.city}`}
    title="Learn from a world-class competitor."
    accent="world-class competitor."
    deck="Gi and no-gi classes for complete beginners and seasoned grapplers alike. Start in Gi Basics, build real technique and train alongside an IBJJF-ranked black belt, whether your goal is fitness, self-defense or competition."
    primary={{ label: 'Book a free class', href: '#book' }}
    secondary={{ label: 'Class times', href: '#tracks' }}
    facts={adults.facts}
  >
    <Photo
      slot="media"
      src={landscape}
      alt="Placeholder photo of adults training"
      priority
      sizes="(min-width: 1024px) 60vw, 100vw"
      widths={[480, 800, 1200, 1600]}
    />
  </Hero>

  <Section tone="surface" id="tracks">
    <SectionHead
      eyebrow="Two tracks"
      heading="Two ways in, one standard."
      accent="one standard."
      lede="Start with the fundamentals, then grow into the full game. Both tracks are taught with the same attention to detail."
    />
    <div class="grid gap-6 lg:grid-cols-2 lg:gap-x-[clamp(1rem,2vw,2rem)]">
      {tracks.map((track) => (
        <TrackCard track={track} />
      ))}
    </div>
    <ProgramRow
      href={noGiCard.href}
      label={`${noGiCard.ages} · ${noGiWhen}`}
      title="No-Gi jiu jitsu"
      accent="jiu jitsu"
      image={square}
      class="mt-16"
    />
  </Section>

  <Section id="never-trained">
    <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-x-[clamp(1rem,2vw,2rem)]">
      <div class="aspect-4/5 overflow-hidden bg-paper-2 lg:col-start-1 lg:col-end-6 lg:row-start-1">
        <Photo
          src={portrait}
          alt="Placeholder photo of a beginner learning a technique"
          grade="mono"
          sizes="(min-width: 1024px) 40vw, 100vw"
          widths={[480, 720, 1000]}
          class="h-full object-cover"
        />
      </div>
      <div class="lg:col-start-7 lg:col-end-13 lg:row-start-1">
        <Eyebrow>Never trained? Good.</Eyebrow>
        <Heading text={neverTrained.heading} accent={neverTrained.accent} class="mt-4" />
        <div class="mt-6 max-w-[56ch] space-y-4 text-lede">
          {neverTrained.body.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
        <div class="mt-10 grid gap-8 sm:grid-cols-2">
          {firstQuote ? (
            <PullQuote
              quote={firstQuote.quote}
              author={firstQuote.author}
              label="Student · Google review"
            />
          ) : null}
          {secondQuote ? (
            <PullQuote
              quote={secondQuote.quote}
              author={secondQuote.author}
              label="Student · Google review"
            />
          ) : null}
        </div>
      </div>
    </div>
  </Section>

  <Section tone="surface" id="women">
    <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-x-[clamp(1rem,2vw,2rem)]">
      <div class="lg:col-start-1 lg:col-end-7">
        <Eyebrow>Women’s jiu jitsu</Eyebrow>
        <Heading text={womens.heading} accent={womens.accent} class="mt-4" />
        <div class="mt-6 max-w-[56ch] space-y-4">
          {womens.body.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
        {womensQuote ? (
          <PullQuote
            class="mt-10"
            quote={womensQuote.quote}
            author={womensQuote.author}
            label={reviewLabel(womensQuote)}
          />
        ) : null}
      </div>
      <div class="aspect-4/5 overflow-hidden bg-paper-2 lg:col-start-8 lg:col-end-13">
        <Photo
          src={square}
          alt="Placeholder photo of a women's class"
          grade="mono"
          sizes="(min-width: 1024px) 40vw, 100vw"
          widths={[480, 720, 1000]}
          class="h-full object-cover"
        />
      </div>
    </div>
  </Section>

  <Section id="inside-a-class">
    <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-x-[clamp(1rem,2vw,2rem)]">
      <div class="lg:col-start-7 lg:col-end-13 lg:row-start-1">
        <Eyebrow>Inside a class</Eyebrow>
        <Heading text="What a class looks like." accent="looks like." class="mt-4" />
        <p class="mt-6 max-w-[56ch] text-lede">
          Every class follows a clear structure, so you always know what comes next.
        </p>
        <NumberedRows items={adultClassSteps} compact class="mt-8" />
      </div>
      <div class="aspect-4/5 overflow-hidden bg-paper-2 lg:col-start-1 lg:col-end-6 lg:row-start-1">
        <Photo
          src={landscape}
          alt="Placeholder photo of an adult class drilling"
          grade="mono"
          sizes="(min-width: 1024px) 40vw, 100vw"
          widths={[480, 720, 1000]}
          class="h-full object-cover"
        />
      </div>
    </div>
  </Section>

  <CoachSpotlight tone="surface" />

  <FaqSection
    items={faqsFor('bjj')}
    heading="Before your first class."
    accent="first class."
    tone="paper"
  />

  <FormBand heading="Your first class is on us." accent="is on us." defaultProgram="adults" />
</BaseLayout>
