---
import landscape from '@/assets/placeholders/landscape.jpg';
import portrait from '@/assets/placeholders/portrait.jpg';
import Button from '@/components/Button.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import FaqSection from '@/components/FaqSection.astro';
import FormBand from '@/components/FormBand.astro';
import Heading from '@/components/Heading.astro';
import Hero from '@/components/Hero.astro';
import NumberedRows from '@/components/NumberedRows.astro';
import Photo from '@/components/Photo.astro';
import QuoteSolo from '@/components/QuoteSolo.astro';
import Section from '@/components/Section.astro';
import SectionHead from '@/components/SectionHead.astro';
import { partySteps, whyParty } from '@/data/birthday';
import { faqsFor } from '@/data/faqs';
import { reviewsFor } from '@/data/reviews';
import { programs } from '@/data/site';
import BaseLayout from '@/layouts/BaseLayout.astro';

const party = programs.find((program) => program.slug === 'birthday-parties')!;
const [review] = reviewsFor('birthday', 1);
---

<BaseLayout
  title="Birthday parties"
  description="A high-energy jiu-jitsu birthday party your kid will talk about for weeks. We run everything. All ages welcome."
  breadcrumbs={[{ label: 'Programs', href: '/programs' }, { label: 'Birthday parties' }]}
>
  <Hero
    eyebrow="Kids Jiu Jitsu Birthday Parties · Ages 4–13"
    title="A birthday they’ll talk about for years."
    accent="talk about for years."
    deck="Trade the bounce house for the mats. Our coaches run a jiu jitsu party that’s active, safe and genuinely fun, and you don’t lift a finger."
    primary={{ label: 'Plan a party', href: '#book' }}
    secondary={{ label: 'How it works', href: '#how' }}
    facts={party.facts}
  >
    <Photo
      slot="media"
      src={landscape}
      alt="Placeholder photo of a birthday party on the mats"
      priority
      sizes="(min-width: 1024px) 60vw, 100vw"
      widths={[480, 800, 1200, 1600]}
    />
  </Hero>

  <Section tone="surface" id="why">
    <SectionHead
      eyebrow="Why a jiu jitsu party"
      heading="What makes it different."
      accent="different."
      lede="A party with a purpose: movement, laughter and real skills, run by the same coaches who teach our kids classes in Glen Burnie every week."
    />
    <NumberedRows items={whyParty} />
  </Section>

  {/* Two photos, wide and tall, bottom-aligned like the original's photo strip */}
  <section class="bg-paper py-[clamp(56px,3rem+4vw,104px)]">
    <div class="page-container grid items-end gap-[clamp(16px,2vw,32px)] lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)]">
      <div class="aspect-3/2 overflow-hidden bg-paper-2 lg:aspect-auto lg:h-[clamp(360px,40vw,600px)]">
        <Photo
          src={landscape}
          alt=""
          grade="soft"
          sizes="(min-width: 1024px) 58vw, 100vw"
          widths={[640, 960, 1280]}
          class="h-full object-cover"
        />
      </div>
      <div class="aspect-4/5 overflow-hidden bg-paper-2 lg:aspect-auto lg:h-[clamp(420px,46vw,680px)]">
        <Photo
          src={portrait}
          alt=""
          grade="soft"
          sizes="(min-width: 1024px) 42vw, 100vw"
          widths={[480, 720, 960]}
          class="h-full object-cover"
        />
      </div>
    </div>
  </section>

  <Section tone="surface" id="how">
    <div class="grid items-start gap-12 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] lg:gap-x-[clamp(16px,2vw,32px)]">
      <header class="lg:sticky lg:top-[calc(var(--spacing-header)+48px)] lg:pr-8">
        <Eyebrow class="mb-4">How it works</Eyebrow>
        <Heading text="Three steps to party day." accent="party day." />
        <p class="mt-6 text-lede">
          Tell us your preferred date in the form, and we’ll reach out to plan the details.
        </p>
        <div class="mt-8">
          <Button href="#book" arrow>
            Plan a party
          </Button>
        </div>
      </header>
      <NumberedRows items={partySteps} compact prefix="Step " />
    </div>
  </Section>

  {review ? <QuoteSolo review={review} /> : null}

  <FaqSection
    items={faqsFor('birthday')}
    heading="Party questions."
    accent="questions."
    tone="surface"
  />

  <FormBand
    eyebrow="Birthday parties · Ages 4–13"
    heading="Let’s plan the party."
    accent="the party."
    body="Pick ‘Birthday party’, leave your details and we’ll call you to plan the day."
    bullets={[
      'Coach-led from start to finish',
      'No experience needed for guests',
      'A clean, padded, supervised space',
    ]}
    defaultProgram="birthday"
  />
</BaseLayout>
