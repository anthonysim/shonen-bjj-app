---
import landscape from '@/assets/placeholders/landscape.jpg';
import portrait from '@/assets/placeholders/portrait.jpg';
import square from '@/assets/placeholders/square.jpg';
import CoachSpotlight from '@/components/CoachSpotlight.astro';
import Definition from '@/components/Definition.astro';
import FormBand from '@/components/FormBand.astro';
import LinkArrow from '@/components/LinkArrow.astro';
import Heading from '@/components/Heading.astro';
import Photo from '@/components/Photo.astro';
import ProgramCard from '@/components/ProgramCard.astro';
import ReviewsBlock from '@/components/ReviewsBlock.astro';
import ScheduleSummary from '@/components/ScheduleSummary.astro';
import Section from '@/components/Section.astro';
import StepCards from '@/components/StepCards.astro';
import SectionHead from '@/components/SectionHead.astro';
import ProgramRow from '@/components/ProgramRow.astro';
import NumberedRows from '@/components/NumberedRows.astro';
import VideoHero from '@/components/VideoHero.astro';
import VisitBlock from '@/components/VisitBlock.astro';
import { firstClassSteps, values } from '@/data/academy';
import { coach } from '@/data/coach';
import { featuredReviews, rating } from '@/data/reviews';
import { programCards, site } from '@/data/site';
import BaseLayout from '@/layouts/BaseLayout.astro';

// Placeholder photos, cycled across the cards
const cardImages = [portrait, square, landscape, portrait];
// Four cards in the grid; birthday parties get the row underneath, like the original
const mainCards = programCards.filter((card) => !card.href.includes('birthday'));
const birthdayCard = programCards.find((card) => card.href.includes('birthday'));
const reviewSummary = `${rating.score.toFixed(1)} \u2605 \u00b7 ${rating.count} ${rating.source} reviews`;
---

<BaseLayout
  overlayHeader
  description={`${site.tagline}. Your first class is free, with no sign-up fees.`}
>
  <VideoHero
    title="Become the hero of your own story."
    accent="your own story."
    eyebrow={`Brazilian Jiu Jitsu · ${site.address.city}, ${site.address.region}`}
    meta={`${site.address.city} · ${site.county}`}
    deck={`World-class jiu jitsu for kids and adults, taught by IBJJF black belt ${coach.displayName}. Your first class is free.`}
    primary={site.cta}
    secondary={{ label: 'Explore programs', href: '/programs' }}
    poster={landscape}
    videoSources={[{ src: '/videos/placeholder-hero.webm', type: 'video/webm' }]}
  >
    <ul class="flex flex-wrap items-center gap-y-2 text-label font-medium tracking-[0.14em] uppercase">
      {[reviewSummary, 'Mendes Brothers black belt', 'No sign-up fees'].map((item) => (
        <li class="border-white/30 px-4 first:pl-0 not-first:border-l">{item}</li>
      ))}
    </ul>
  </VideoHero>

  <Section tone="paper">
    <div class="grid items-center gap-8 lg:grid-cols-2 lg:gap-14">
      <div data-reveal>
        <Definition
          word="Sh\u014dnen"
          pronunciation="show-nuhn"
          partOfSpeech="noun"
          meaning="High-action narratives that focus on competitions or fights to decide their storylines. These stories stress values such as self-perfection, self-discipline, and honorable service to community, family, and friends."
        />
      </div>
      <div data-reveal style={{ '--i': 1 }}>
        <Heading
          text="Superior to your average martial arts academy."
          accent="martial arts academy."
        />
        <p class="mt-6">
          Shonen was built to offer world-class instruction that specializes in jiu jitsu, instead
          of following the trend of being a sub-par MMA school. Every class is organized, supervised
          and taught with the same attention to detail, whether it's your first day or your
          hundredth.
        </p>
        <LinkArrow href="/about" class="mt-6 text-ink">
          Our story
        </LinkArrow>
      </div>
    </div>
  </Section>

  <Section tone="surface" id="programs">
    <SectionHead
      eyebrow="Our programs"
      heading="Training for every stage."
      accent="every stage."
      lede="Classes are grouped by age, so every student trains with partners their own size. The first class is always free."
    />
    <ul class="grid grid-cols-2 gap-x-3 gap-y-8 sm:gap-x-[clamp(16px,2vw,32px)] sm:gap-y-12 xl:grid-cols-4">
      {mainCards.map((card, index) => (
        <li class="flex">
          <ProgramCard
            card={card}
            index={index}
            image={cardImages[index % cardImages.length]}
            class="w-full"
          />
        </li>
      ))}
    </ul>
    {birthdayCard ? (
      <ProgramRow
        href={birthdayCard.href}
        label={birthdayCard.ages}
        title={`${birthdayCard.name} on the mat`}
        accent="on the mat"
        image={landscape}
        class="mt-[clamp(40px,5vw,72px)]"
      />
    ) : null}
  </Section>

  <CoachSpotlight tone="paper" />

  <StepCards
    id="new-here"
    eyebrow="New here?"
    heading="Your first class, step by step."
    accent="step by step."
    lede="No experience, no fitness requirement and no pressure. Here's exactly what happens."
    steps={firstClassSteps}
    images={[portrait, square, landscape]}
    cta={site.cta}
  />

  <Section tone="paper" id="why">
    <SectionHead
      eyebrow="Why Shonen"
      heading="Details matter."
      accent="matter."
      lede="It's the phrase our members use most, and it's the standard behind every class, every mat and every interaction."
    />
    <div class="grid items-start gap-12 xl:grid-cols-[minmax(0,8fr)_minmax(0,4fr)] xl:gap-x-[clamp(40px,5vw,96px)]">
      <NumberedRows items={values} narrow />
      <figure class="hidden xl:sticky xl:top-[calc(var(--spacing-header)+48px)] xl:block">
        <div class="aspect-4/5 overflow-hidden bg-paper-2">
          <Photo
            src={portrait}
            alt="Placeholder photo of the academy mats"
            grade="mono"
            sizes="30vw"
            widths={[320, 480, 640]}
            class="h-full object-cover"
          />
        </div>
        <figcaption class="mt-3 text-label font-medium tracking-[0.14em] text-muted uppercase">
          The academy, {site.address.city}
        </figcaption>
      </figure>
    </div>
  </Section>

  <ReviewsBlock
    reviews={featuredReviews()}
    heading="What our members say."
    accent="say."
    tone="surface"
  />

  <ScheduleSummary tone="paper" />

  <VisitBlock tone="surface" />

  <FormBand />
</BaseLayout>
