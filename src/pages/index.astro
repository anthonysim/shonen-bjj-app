---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { site } from '@/data/site';
---

<BaseLayout>
  <section class="mx-auto max-w-5xl px-4 py-12 md:px-8 md:py-20">
    <h1 class="text-brand-600 text-3xl font-bold md:text-5xl lg:text-6xl">{site.name}</h1>
    <p class="mt-4 text-base md:text-lg">{site.tagline}</p>
  </section>
</BaseLayout>
