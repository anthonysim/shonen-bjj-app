---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { formatDate, getPublishedPosts } from '@/lib/blog';

const posts = await getPublishedPosts();
---

<BaseLayout title="Blog" description="News, training tips, and updates from the academy.">
  <section class="mx-auto max-w-3xl px-4 py-12 md:px-8 md:py-20">
    <h1 class="text-3xl font-bold md:text-5xl">Blog</h1>
    {posts.length > 0 ? (
      <ul class="mt-8 divide-y divide-black/10">
        {posts.map((post) => (
          <li class="py-6">
            <a href={`/blog/${post.id}`} class="group block">
              <time datetime={post.data.pubDate.toISOString()} class="text-sm text-black/60">
                {formatDate(post.data.pubDate)}
              </time>
              <h2 class="group-hover:text-brand-600 mt-1 text-xl font-semibold md:text-2xl">
                {post.data.title}
              </h2>
              <p class="mt-2 text-black/70">{post.data.description}</p>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="mt-6 text-black/60">No posts yet.</p>
    )}
  </section>
</BaseLayout>
