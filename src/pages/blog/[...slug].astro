---
// One blog post, like the original: split hero (category, title, intro, date and reading time,
// photo), the article in a 760px column, the post's call-to-action buttons, and the booking band.
// JSON-LD: BlogPosting.
import defaultPhoto from '@/assets/photos/dscf6406.webp';
import Button from '@/components/Button.astro';
import CtaBand from '@/components/CtaBand.astro';
import Hero from '@/components/Hero.astro';
import LinkArrow from '@/components/LinkArrow.astro';
import Photo from '@/components/Photo.astro';
import Section from '@/components/Section.astro';
import { site } from '@/data/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { formatDate, readingMinutes } from '@/lib/blog';
import { blogPostingJsonLd } from '@/lib/structured-data';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { data } = post;
const pageUrl = new URL(`/blog/${post.id}`, Astro.site).href;
const image = data.image ?? defaultPhoto;
const meta = `${formatDate(data.pubDate)} · ${readingMinutes(post.body ?? '')} min read`;
const posting = blogPostingJsonLd(
  {
    url: pageUrl,
    title: data.title,
    description: data.description,
    datePublished: data.pubDate,
    imageUrl: new URL(image.src, Astro.site).href,
  },
  Astro.site!.origin,
);
---

<BaseLayout
  title={data.title}
  description={data.description}
  breadcrumbs={[{ label: 'Blog', href: '/blog' }, { label: data.crumb ?? data.title }]}
  structuredData={[posting]}
  ogType="article"
>
  <Hero eyebrow={data.category} title={data.title} deck={data.lede} facts={[meta]}>
    <Photo
      slot="media"
      src={image}
      alt={data.imageAlt}
      priority
      grade="mono"
      sizes="(min-width: 1024px) 60vw, 100vw"
      widths={[480, 800, 1200, 1600]}
    />
  </Hero>

  <Section tone="surface" containerClass="[--page-max:47.5rem]">
    <article class="prose max-w-none text-body prose-headings:font-display prose-headings:font-light prose-headings:tracking-[-0.015em] prose-headings:text-ink prose-h2:mt-14 prose-h2:text-h3 prose-p:text-body prose-a:text-ink prose-a:underline-offset-[3px] prose-blockquote:border-line-strong prose-blockquote:font-display prose-blockquote:font-light prose-blockquote:text-ink prose-strong:text-ink prose-li:marker:text-muted md:prose-lg">
      <Content />
    </article>
    {data.ctas.length > 0 ? (
      <div class="mt-12 flex flex-wrap items-center gap-x-6 gap-y-4 border-t border-line pt-8">
        {/* First a solid button, then text links, like the original */}
        {data.ctas.map((cta, index) =>
          index === 0 ? (
            <Button href={cta.href} arrow>
              {cta.label}
            </Button>
          ) : (
            <LinkArrow href={cta.href} class="text-ink">
              {cta.label}
            </LinkArrow>
          ),
        )}
      </div>
    ) : null}
  </Section>

  <CtaBand
    heading="Ready to step on the mat?"
    accent="on the mat?"
    body="Every class on the schedule is open to first-timers, and a clean gi is waiting for you."
    primary={site.cta}
    secondary={{ label: 'See class times', href: '/schedule' }}
  />
</BaseLayout>
