---
import '@/styles/global.css';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Footer from '@/components/Footer.astro';
import Header from '@/components/Header.astro';
import { site } from '@/data/site';
import {
  breadcrumbListJsonLd,
  localBusinessJsonLd,
  serializeJsonLd,
  type BreadcrumbItem,
} from '@/lib/structured-data';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** Trail after Home, ending with the current page (no href). Omit on the homepage. */
  breadcrumbs?: BreadcrumbItem[];
}

const { title, description = site.tagline, noindex = false, breadcrumbs } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : site.name;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const crumbs: BreadcrumbItem[] | null = breadcrumbs
  ? [{ label: 'Home', href: '/' }, ...breadcrumbs]
  : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : null}
    <meta name="theme-color" content="#f5f2eb" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <script
      type="application/ld+json"
      set:html={serializeJsonLd(localBusinessJsonLd(new URL('/', Astro.site).href))}
    />
    {crumbs ? (
      <script
        type="application/ld+json"
        set:html={serializeJsonLd(breadcrumbListJsonLd(crumbs, Astro.site!.origin, canonical))}
      />
    ) : null}
    <title>{fullTitle}</title>
  </head>
  <body>
    <a
      href="#main"
      class="bg-ink sr-only z-50 rounded-card px-4 py-2 text-white focus:not-sr-only focus:absolute focus:top-2 focus:left-2"
    >
      Skip to content
    </a>
    <Header />
    <main id="main">
      {crumbs ? (
        <div class="mx-auto max-w-[1280px] px-[clamp(1.25rem,4vw,3rem)] pt-2">
          <Breadcrumbs crumbs={crumbs} />
        </div>
      ) : null}
      <slot />
    </main>
    <Footer />
  </body>
</html>
