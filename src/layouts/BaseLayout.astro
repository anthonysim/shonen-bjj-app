---
import '@/styles/global.css';
// Preload the latin font files so they arrive with the HTML instead of after the CSS is parsed.
// These must be the exact files global.css's @font-face rules use, or the browser downloads twice.
import dmSans from '@fontsource-variable/dm-sans/files/dm-sans-latin-opsz-normal.woff2?url';
import frauncesItalic from '@fontsource-variable/fraunces/files/fraunces-latin-opsz-italic.woff2?url';
import frauncesNormal from '@fontsource-variable/fraunces/files/fraunces-latin-opsz-normal.woff2?url';
import Footer from '@/components/Footer.astro';
import Header from '@/components/Header.astro';
import { metaFor } from '@/data/seo';
import { site } from '@/data/site';
import {
  breadcrumbListJsonLd,
  localBusinessJsonLd,
  serializeJsonLd,
  type BreadcrumbItem,
  withHome,
} from '@/lib/structured-data';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** Trail after Home, ending with the current page (no href). Omit on the homepage. */
  breadcrumbs?: BreadcrumbItem[];
  /** Float a transparent header over a dark full-bleed hero (homepage). */
  overlayHeader?: boolean;
  /** Extra JSON-LD objects for this page (e.g. the coach's ProfilePage). */
  structuredData?: readonly unknown[];
  /** Link-preview image: a path under /public or a full URL. Defaults to the site's share image. */
  image?: string;
  /** Open Graph type: blog posts use "article". */
  ogType?: 'website' | 'article';
}

const {
  title,
  description: pageDescription = site.tagline,
  noindex = false,
  breadcrumbs,
  overlayHeader = false,
  structuredData = [],
  image,
  ogType = 'website',
} = Astro.props;
// The original site's own title and description win where it has the page
const original = metaFor(Astro.url.pathname);
const description = original?.description ?? pageDescription;
const fullTitle = original?.title ?? (title ? `${title} | ${site.name}` : site.name);
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// Link previews need an absolute image URL. Only the default image has known dimensions.
const { shareImage } = site;
const ogImage = new URL(image ?? shareImage.path, Astro.site).href;
const ogImageIsDefault = image === undefined;
const crumbs: BreadcrumbItem[] | null = breadcrumbs ? withHome(breadcrumbs) : null;
// The page's Hero shows the trail (it renders after this frontmatter runs)
if (crumbs) Astro.locals.breadcrumbs = crumbs;
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : null}
    <meta name="theme-color" content="#f5f2eb" />
    {[dmSans, frauncesNormal, frauncesItalic].map((href) => (
      <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />
    ))}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    {ogImageIsDefault ? (
      <>
        <meta property="og:image:width" content={String(shareImage.width)} />
        <meta property="og:image:height" content={String(shareImage.height)} />
        <meta property="og:image:alt" content={shareImage.alt} />
      </>
    ) : null}
    <meta name="twitter:card" content="summary_large_image" />
    <script
      type="application/ld+json"
      set:html={serializeJsonLd(localBusinessJsonLd(new URL('/', Astro.site).href))}
    />
    {crumbs ? (
      <script
        type="application/ld+json"
        set:html={serializeJsonLd(breadcrumbListJsonLd(crumbs, Astro.site!.origin, canonical))}
      />
    ) : null}
    {structuredData.map((data) => (
      <script type="application/ld+json" set:html={serializeJsonLd(data)} />
    ))}
    <title>{fullTitle}</title>
    {/* Before first paint: mark JS as running so scroll reveals can start hidden */}
    <script is:inline>
      document.documentElement.classList.replace('no-js', 'js');
    </script>
  </head>
  <body>
    <a
      href="#main"
      class="bg-ink sr-only z-70 rounded-card px-4 py-2 text-white focus:not-sr-only focus:absolute focus:top-2 focus:left-2"
    >
      Skip to content
    </a>
    <Header overlay={overlayHeader} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import { initReveals } from '@/lib/reveal';
      initReveals();
    </script>
  </body>
</html>
