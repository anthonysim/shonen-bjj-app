---
import Button from '@/components/Button.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import Heading from '@/components/Heading.astro';
import Section from '@/components/Section.astro';

interface Cta {
  label: string;
  href: string;
}

interface Props {
  eyebrow?: string;
  heading: string;
  accent?: string;
  body?: string;
  primary: Cta;
  secondary?: Cta;
  tone?: 'dark' | 'paper';
}

const {
  eyebrow = 'Your first class is free',
  heading,
  accent,
  body,
  primary,
  secondary,
  tone = 'dark',
} = Astro.props;
const isDark = tone === 'dark';
---

<Section tone={tone} size="md" class="text-center">
  {eyebrow ? <Eyebrow class:list={['mb-4', isDark && 'text-white/55']}>{eyebrow}</Eyebrow> : null}
  <Heading text={heading} accent={accent} />
  {body ? (
    <p class:list={['mx-auto mt-5 max-w-prose text-lede', isDark && 'text-white/72']}>{body}</p>
  ) : null}
  <div class="mt-8 flex flex-wrap justify-center gap-3">
    <Button href={primary.href} size="lg" variant={isDark ? 'inverse' : 'primary'} arrow>
      {primary.label}
    </Button>
    {secondary ? (
      <Button href={secondary.href} size="lg" variant="secondary">
        {secondary.label}
      </Button>
    ) : null}
  </div>
</Section>
