---
// "Find your time", like the original: one white card per category with its class times, a
// link to the program, and a note plus "Full schedule" link underneath.
import Eyebrow from '@/components/Eyebrow.astro';
import LinkArrow from '@/components/LinkArrow.astro';
import Section from '@/components/Section.astro';
import SectionHead from '@/components/SectionHead.astro';
import {
  classesByCategory,
  formatDaysFriendly,
  formatTime,
  type Category,
  type ScheduleClass,
} from '@/data/schedule';

interface Props {
  tone?: 'paper' | 'surface';
}

const { tone = 'paper' } = Astro.props;

const cards: Record<Category, { label: string; title: string; link: string; href: string }> = {
  kids: { label: 'Ages 4–13', title: 'Kids', link: 'Kids program', href: '/programs/kids' },
  gi: { label: 'Ages 14+ · Gi', title: 'Adults', link: 'Adult program', href: '/programs/bjj' },
  'no-gi': {
    label: 'Ages 14+ · No-Gi',
    title: 'No-Gi',
    link: 'No-Gi program',
    href: '/programs/no-gi',
  },
};

// Adult gi classes say which class it is ("Basics · Mon–Thu"); the others just give the days
function rowLabel(cls: ScheduleClass) {
  if (cls.category !== 'gi') return formatDaysFriendly(cls.days);
  const name = cls.name.replace(/^Gi\s+/, '');
  return `${name} · ${formatDaysFriendly(cls.days, { short: true })}`;
}

// Skip categories with no classes so a card never renders empty
const groups = classesByCategory().filter((group) => group.classes.length > 0);
---

<Section tone={tone} id="class-times">
  <SectionHead eyebrow="Schedule" heading="Find your time." accent="time." split={false} />

  <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3 lg:gap-[clamp(1rem,2vw,2rem)]">
    {groups.map((group, index) => {
      const card = cards[group.category];
      return (
        <section
          data-reveal
          style={{ '--i': index }}
          class="flex flex-col rounded-card border border-line bg-surface p-[clamp(1.5rem,3vw,2.5rem)]"
        >
          <Eyebrow>{card.label}</Eyebrow>
          <h3 class="mt-3 text-h3">{card.title}</h3>
          <dl class="mt-6 text-sm">
            {group.classes.map((cls) => (
              <div class="flex items-baseline justify-between gap-4 border-t border-line py-3 last:border-b">
                <dt>{rowLabel(cls)}</dt>
                <dd class="whitespace-nowrap text-ink">{formatTime(cls.start)}</dd>
              </div>
            ))}
          </dl>
          <LinkArrow href={card.href} class="mt-auto pt-10 text-ink">
            {card.link}
          </LinkArrow>
        </section>
      );
    })}
  </div>

  <div class="mt-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <p class="text-sm">Every class is open to first-timers. Sunday: closed.</p>
    <LinkArrow href="/schedule" class="text-ink">
      Full schedule
    </LinkArrow>
  </div>
</Section>
