---
import Button from '@/components/Button.astro';
import Heading from '@/components/Heading.astro';
import Section from '@/components/Section.astro';
import { categoryLabels, classesByCategory, formatDays, formatTime } from '@/data/schedule';

interface Props {
  tone?: 'paper' | 'surface';
}

const { tone = 'paper' } = Astro.props;
// Skip categories with no classes so a group never renders empty
const groups = classesByCategory().filter((group) => group.classes.length > 0);
---

<Section tone={tone} id="class-times">
  <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
    <Heading text="Class times" accent="times" />
    <p class="text-muted">Closed Sundays. Arrive 15 minutes early for your first class.</p>
  </div>

  <div class="mt-8 grid gap-6 lg:grid-cols-3">
    {groups.map((group) => (
      <section class="border-line bg-surface text-body rounded-card border p-6">
        <h3 class="font-display text-2xl">{categoryLabels[group.category]}</h3>
        <ul class="divide-line mt-3 divide-y">
          {group.classes.map((cls) => (
            <li class="flex items-baseline justify-between gap-4 py-3">
              <div>
                <p class="font-semibold">{cls.name}</p>
                <p class="text-muted text-sm">{formatDays(cls.days)}</p>
              </div>
              <p class="font-semibold whitespace-nowrap">{formatTime(cls.start)}</p>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>

  <div class="mt-8">
    <Button href="/schedule" variant="secondary">
      See the full schedule
    </Button>
  </div>
</Section>
