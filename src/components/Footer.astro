---
import { footerLinks, site } from '@/data/site';

const { address } = site;
const cityLine = `${address.city}, ${address.region} ${address.postalCode}`;
const year = new Date().getFullYear();
---

<footer class="bg-ink text-white [--heading:#fff]">
  <div class="mx-auto grid max-w-[1280px] gap-8 px-[clamp(1.25rem,4vw,3rem)] py-12 md:grid-cols-2 lg:grid-cols-4">
    <div>
      <p class="font-display text-2xl font-light italic">{site.name}</p>
      <p class="mt-2 text-sm text-white/80">{site.tagline}</p>
    </div>

    <div>
      <h2 class="font-sans text-label font-medium tracking-[0.14em] uppercase">Visit</h2>
      <address class="mt-3 text-sm text-white/80 not-italic">
        {address.street}
        <br />
        {cityLine}
      </address>
      <p class="mt-3 flex flex-col text-sm">
        <a href={site.phone.href} class="inline-flex min-h-11 items-center underline">
          {site.phone.display}
        </a>
        <a href={`mailto:${site.email}`} class="inline-flex min-h-11 items-center underline">
          {site.email}
        </a>
      </p>
    </div>

    <div>
      <h2 class="font-sans text-label font-medium tracking-[0.14em] uppercase">Hours</h2>
      <dl class="mt-3 space-y-1 text-sm text-white/80">
        {site.hours.map((h) => (
          <div class="flex justify-between gap-4">
            <dt>{h.days}</dt>
            <dd>{h.time}</dd>
          </div>
        ))}
      </dl>
    </div>

    <div>
      <h2 class="font-sans text-label font-medium tracking-[0.14em] uppercase">Serving</h2>
      <p class="mt-3 text-sm text-white/80">{site.serviceArea.join(', ')}</p>
      <ul class="mt-3 flex gap-2">
        {site.social.map((s) => (
          <li>
            <a
              href={s.href}
              class="inline-flex min-h-11 items-center px-1 text-sm underline"
              rel="noopener"
            >
              {s.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="border-t border-white/15">
    <div class="mx-auto flex max-w-[1280px] flex-col gap-1 px-[clamp(1.25rem,4vw,3rem)] py-4 text-sm text-white/70 md:flex-row md:items-center md:justify-between">
      <p>
        &copy; {year} {site.name}
      </p>
      <ul class="flex flex-wrap gap-x-4">
        {footerLinks.map((l) => (
          <li>
            <a href={l.href} class="inline-flex min-h-11 items-center underline">
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</footer>
