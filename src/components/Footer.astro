---
import { footerLinks, site } from '@/data/site';

const { address } = site;
const year = new Date().getFullYear();
---

<footer class="bg-brand-900 text-white">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-12 md:grid-cols-2 md:px-8 lg:grid-cols-4">
    <div>
      <p class="text-lg font-bold">{site.name}</p>
      <p class="mt-2 text-sm text-white/80">{site.tagline}</p>
    </div>

    <div>
      <h2 class="text-sm font-semibold tracking-wide uppercase">Visit</h2>
      <address class="mt-3 text-sm text-white/80 not-italic">
        {address.street}
        <br />
        {address.city}, {address.region}
        {address.postalCode}
      </address>
      <p class="mt-3 flex flex-col text-sm">
        <a href={site.phone.href} class="inline-flex min-h-11 items-center underline">
          {site.phone.display}
        </a>
        <a href={`mailto:${site.email}`} class="inline-flex min-h-11 items-center underline">
          {site.email}
        </a>
      </p>
    </div>

    <div>
      <h2 class="text-sm font-semibold tracking-wide uppercase">Hours</h2>
      <dl class="mt-3 space-y-1 text-sm text-white/80">
        {site.hours.map((h) => (
          <div class="flex justify-between gap-4">
            <dt>{h.days}</dt>
            <dd>{h.time}</dd>
          </div>
        ))}
      </dl>
    </div>

    <div>
      <h2 class="text-sm font-semibold tracking-wide uppercase">Serving</h2>
      <p class="mt-3 text-sm text-white/80">{site.serviceArea.join(', ')}</p>
      <ul class="mt-3 flex gap-2">
        {site.social.map((s) => (
          <li>
            <a
              href={s.href}
              class="inline-flex min-h-11 items-center px-1 text-sm underline"
              rel="noopener"
            >
              {s.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="border-t border-white/15">
    <div class="mx-auto flex max-w-6xl flex-col gap-1 px-4 py-4 text-sm text-white/70 md:flex-row md:items-center md:justify-between md:px-8">
      <p>
        &copy; {year} {site.name}
      </p>
      <ul class="flex flex-wrap gap-x-4">
        {footerLinks.map((l) => (
          <li>
            <a href={l.href} class="inline-flex min-h-11 items-center underline">
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</footer>
