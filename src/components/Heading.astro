---
import { accentTail } from '@/lib/text';

interface Props {
  text: string;
  /** Where the italic tail starts: this phrase through the end of `text` is italicized. */
  accent?: string;
  /** Semantic level (document outline). Independent of visual `size`. */
  level?: 1 | 2 | 3 | 4;
  size?: 'display' | 'xl' | 'lg' | 'md';
  class?: string;
}

const { text, accent, level = 2, size = 'lg', class: className } = Astro.props;
const Tag = `h${level}` as 'h1' | 'h2' | 'h3' | 'h4';
const parts = accentTail(text, accent);

const sizes = {
  display: 'text-display',
  xl: 'text-h1',
  lg: 'text-h2',
  md: 'text-h3',
} as const;
---

<Tag class:list={[sizes[size], className]}>
  {parts ? (
    <>
      {parts.before}
      <em class="italic">{parts.accent}</em>
      {parts.after}
    </>
  ) : (
    text
  )}
</Tag>
