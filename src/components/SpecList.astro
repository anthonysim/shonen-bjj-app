---
// Label/value rows between hairlines, like the original's spec rows: a small tracked label in an
// 88px column and the value beside it.
interface Spec {
  label: string;
  value: string;
}

interface Props {
  items: readonly Spec[];
  class?: string;
}

const { items, class: className } = Astro.props;
---

<dl class={className}>
  {items.map((item) => (
    <div class="grid grid-cols-[88px_minmax(0,1fr)] items-baseline gap-4 border-t border-line py-3 text-sm leading-normal last:border-b">
      <dt class="text-label leading-[1.8] font-medium tracking-[0.14em] text-muted uppercase">
        {item.label}
      </dt>
      <dd class="text-ink">{item.value}</dd>
    </div>
  ))}
</dl>
