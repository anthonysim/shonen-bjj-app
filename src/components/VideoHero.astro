---
import type { ImageMetadata } from 'astro';
import Button from '@/components/Button.astro';
import Container from '@/components/Container.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import Heading from '@/components/Heading.astro';
import Photo from '@/components/Photo.astro';

interface Cta {
  label: string;
  href: string;
}

interface Props {
  eyebrow?: string;
  /** Small line pinned top right on desktop, e.g. the neighborhood. */
  meta?: string;
  title: string;
  accent?: string;
  deck?: string;
  primary?: Cta;
  secondary?: Cta;
  /** Shown while the video loads, and instead of it on phones, reduced motion, and Save-Data. */
  poster: ImageMetadata;
  /** Background video. Omit for an image-only hero. Order sources from most to least preferred. */
  videoSources?: { src: string; type: string }[];
}

const {
  eyebrow,
  meta,
  title,
  accent,
  deck,
  primary,
  secondary,
  poster,
  videoSources = [],
} = Astro.props;
const hasVideo = videoSources.length > 0;
// Lines up with the content column's edge at every width (page-container: gutter, 80rem cap)
const edge = 'max(var(--spacing-gutter), calc((100% - 80rem) / 2))';
---

<section
  data-video-hero
  class="group/hero relative isolate flex min-h-[max(40rem,min(100svh,58.75rem))] flex-col justify-end overflow-hidden bg-ink pt-[calc(var(--spacing-header)+3rem)] pb-[clamp(2.5rem,8vh,6rem)] text-white [--heading:#fff]"
>
  <Photo
    src={poster}
    alt=""
    priority
    grade="hero"
    sizes="100vw"
    widths={[640, 1024, 1600, 2560]}
    class="absolute inset-0 -z-20 h-full object-cover object-[50%_40%] opacity-45 transition-opacity duration-1000 group-has-[video[data-playing]]/hero:opacity-0"
  />
  {hasVideo ? (
    <video
      muted
      loop
      playsinline
      preload="none"
      aria-hidden="true"
      tabindex="-1"
      class="grade-hero absolute inset-0 -z-10 h-full w-full object-cover object-[50%_40%] opacity-0 transition-opacity duration-1000 data-[playing]:opacity-45"
    >
      {/* No src until the script decides to play, so nothing downloads on phones */}
      {videoSources.map((source) => (
        <source data-src={source.src} type={source.type} />
      ))}
    </video>
  ) : null}
  {/* Dark at the top (header) and bottom (copy), lighter in the middle, darker on the copy side */}
  <div
    aria-hidden="true"
    class="absolute inset-0 -z-[5] bg-[linear-gradient(180deg,rgb(0_0_0/0.55)_0%,rgb(0_0_0/0.15)_30%,rgb(0_0_0/0.2)_55%,rgb(0_0_0/0.92)_100%),linear-gradient(90deg,rgb(0_0_0/0.6)_0%,rgb(0_0_0/0)_60%)]"
  ></div>

  {meta ? (
    <p
      style={{ right: edge }}
      class="hero-rise absolute top-[calc(var(--spacing-header)+2.5rem)] hidden [--rise-delay:750ms] items-center gap-3.5 text-label font-medium tracking-[0.14em] text-white/55 uppercase before:h-px before:w-10 before:bg-white/35 lg:flex"
    >
      {meta}
    </p>
  ) : null}

  <Container class="relative">
    {eyebrow ? (
      <Eyebrow class="hero-rise text-white/55 [--rise-delay:150ms]">{eyebrow}</Eyebrow>
    ) : null}
    <Heading
      level={1}
      size="display"
      text={title}
      accent={accent}
      class="hero-rise mt-[clamp(1.25rem,2.4vw,2rem)] max-w-[65rem] [--rise-delay:270ms]"
    />
    {deck ? (
      <p class="hero-rise mt-[clamp(1.25rem,2.2vw,2rem)] max-w-[46ch] text-lede text-white/72 [--rise-delay:390ms]">
        {deck}
      </p>
    ) : null}
    {primary || secondary ? (
      <div class="hero-rise mt-[clamp(1.75rem,3vw,2.75rem)] flex flex-wrap gap-x-6 gap-y-4 [--rise-delay:510ms]">
        {primary ? (
          <Button href={primary.href} size="lg" variant="inverse" arrow>
            {primary.label}
          </Button>
        ) : null}
        {secondary ? (
          <Button href={secondary.href} size="lg" variant="secondary" class="text-white">
            {secondary.label}
          </Button>
        ) : null}
      </div>
    ) : null}
    <div class="hero-rise mt-[clamp(2.25rem,5vw,4.5rem)] [--rise-delay:630ms]">
      <slot />
    </div>
  </Container>

  {hasVideo ? (
    <button
      type="button"
      data-video-toggle
      hidden
      aria-label="Pause background video"
      style={{ right: edge }}
      class="absolute top-[calc(var(--spacing-header)+1rem)] z-[2] inline-flex size-11 items-center justify-center rounded-full border border-white/35 bg-black/20 text-white transition-colors duration-300 hover:border-white hover:bg-black/40 lg:top-auto lg:bottom-[clamp(2.5rem,8vh,6rem)]"
    >
      <svg
        data-icon="pause"
        aria-hidden="true"
        viewBox="0 0 24 24"
        class="size-4"
        fill="currentColor"
      >
        <path d="M7 5h4v14H7zM13 5h4v14h-4z" />
      </svg>
      <svg
        data-icon="play"
        aria-hidden="true"
        viewBox="0 0 24 24"
        class="hidden size-4"
        fill="currentColor"
      >
        <path d="M8 5v14l11-7z" />
      </svg>
    </button>
  ) : null}
</section>

<script>
  import { HERO_VIDEO_MEDIA, shouldAutoplayVideo } from '@/lib/video';

  type NavigatorWithConnection = Navigator & { connection?: { saveData?: boolean } };

  function setup(hero: HTMLElement) {
    const video = hero.querySelector('video');
    const toggle = hero.querySelector<HTMLButtonElement>('[data-video-toggle]');
    if (!video || !toggle) return;

    const wide = matchMedia(HERO_VIDEO_MEDIA);
    const motion = matchMedia('(prefers-reduced-motion: reduce)');
    let loaded = false;
    let pausedByUser = false;

    const allowed = () =>
      shouldAutoplayVideo({
        wideEnough: wide.matches,
        reducedMotion: motion.matches,
        saveData: (navigator as NavigatorWithConnection).connection?.saveData === true,
      });

    const showIcon = (playing: boolean) => {
      toggle.setAttribute(
        'aria-label',
        playing ? 'Pause background video' : 'Play background video',
      );
      toggle.querySelector('[data-icon=pause]')?.classList.toggle('hidden', !playing);
      toggle.querySelector('[data-icon=play]')?.classList.toggle('hidden', playing);
    };

    const play = () => {
      if (!loaded) {
        for (const source of video.querySelectorAll<HTMLSourceElement>('source[data-src]')) {
          source.src = source.dataset.src!;
        }
        video.load();
        loaded = true;
      }
      video.play().then(
        () => {
          video.dataset.playing = '';
          toggle.hidden = false;
          showIcon(true);
        },
        // Autoplay blocked or unsupported format: the poster stays, no control shown.
        () => {},
      );
    };

    const stop = () => {
      video.pause();
      delete video.dataset.playing;
      toggle.hidden = true;
    };

    const evaluate = () => {
      if (allowed()) {
        if (!pausedByUser) play();
      } else {
        stop();
      }
    };

    toggle.addEventListener('click', () => {
      if (video.paused) {
        pausedByUser = false;
        play();
      } else {
        pausedByUser = true;
        video.pause();
        showIcon(false);
      }
    });

    wide.addEventListener('change', evaluate);
    motion.addEventListener('change', evaluate);
    evaluate();
  }

  for (const hero of document.querySelectorAll<HTMLElement>('[data-video-hero]')) {
    setup(hero);
  }
</script>
