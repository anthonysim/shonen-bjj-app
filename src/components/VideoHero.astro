---
import type { ImageMetadata } from 'astro';
import Button from '@/components/Button.astro';
import Container from '@/components/Container.astro';
import Heading from '@/components/Heading.astro';
import Photo from '@/components/Photo.astro';

interface Cta {
  label: string;
  href: string;
}

interface Props {
  title: string;
  accent?: string;
  deck?: string;
  primary?: Cta;
  secondary?: Cta;
  /** Shown while the video loads, and instead of it on phones, reduced motion, and Save-Data. */
  poster: ImageMetadata;
  /** Background video. Omit for an image-only hero. Order sources from most to least preferred. */
  videoSources?: { src: string; type: string }[];
}

const { title, accent, deck, primary, secondary, poster, videoSources = [] } = Astro.props;
const hasVideo = videoSources.length > 0;
---

<section
  data-video-hero
  class="relative isolate flex min-h-[34rem] items-end overflow-hidden bg-brand-900 text-white [--accent:var(--color-brand-500)] md:min-h-[38rem] lg:min-h-[42rem]"
>
  <Photo
    src={poster}
    alt=""
    priority
    sizes="100vw"
    widths={[640, 1024, 1600]}
    class="absolute inset-0 -z-20 h-full object-cover"
  />
  {hasVideo ? (
    <video
      muted
      loop
      playsinline
      preload="none"
      aria-hidden="true"
      tabindex="-1"
      class="absolute inset-0 -z-10 h-full w-full object-cover opacity-0 transition-opacity duration-700 data-[playing]:opacity-100"
    >
      {/* No src until the script decides to play, so nothing downloads on phones */}
      {videoSources.map((source) => (
        <source data-src={source.src} type={source.type} />
      ))}
    </video>
  ) : null}
  <div
    aria-hidden="true"
    class="absolute inset-0 -z-[5] bg-linear-to-t from-black/80 via-black/50 to-black/30"
  ></div>

  <Container class="relative py-14 md:py-20 lg:py-24">
    <Heading level={1} size="display" text={title} accent={accent} class="max-w-4xl" />
    {deck ? <p class="mt-5 max-w-prose text-lg md:text-xl">{deck}</p> : null}
    {primary || secondary ? (
      <div class="mt-7 flex flex-wrap gap-3">
        {primary ? (
          <Button href={primary.href} size="lg" variant="inverse">
            {primary.label}
          </Button>
        ) : null}
        {secondary ? (
          <Button href={secondary.href} size="lg" variant="secondary">
            {secondary.label}
          </Button>
        ) : null}
      </div>
    ) : null}
    <div class="mt-7">
      <slot />
    </div>
  </Container>

  {hasVideo ? (
    <button
      type="button"
      data-video-toggle
      hidden
      aria-label="Pause background video"
      class="absolute right-4 bottom-4 inline-flex size-11 items-center justify-center rounded-full bg-black/50 text-white backdrop-blur hover:bg-black/70 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white md:right-8 md:bottom-6"
    >
      <svg
        data-icon="pause"
        aria-hidden="true"
        viewBox="0 0 24 24"
        class="size-5"
        fill="currentColor"
      >
        <path d="M7 5h4v14H7zM13 5h4v14h-4z" />
      </svg>
      <svg
        data-icon="play"
        aria-hidden="true"
        viewBox="0 0 24 24"
        class="hidden size-5"
        fill="currentColor"
      >
        <path d="M8 5v14l11-7z" />
      </svg>
    </button>
  ) : null}
</section>

<script>
  import { HERO_VIDEO_MEDIA, shouldAutoplayVideo } from '@/lib/video';

  type NavigatorWithConnection = Navigator & { connection?: { saveData?: boolean } };

  function setup(hero: HTMLElement) {
    const video = hero.querySelector('video');
    const toggle = hero.querySelector<HTMLButtonElement>('[data-video-toggle]');
    if (!video || !toggle) return;

    const wide = matchMedia(HERO_VIDEO_MEDIA);
    const motion = matchMedia('(prefers-reduced-motion: reduce)');
    let loaded = false;
    let pausedByUser = false;

    const allowed = () =>
      shouldAutoplayVideo({
        wideEnough: wide.matches,
        reducedMotion: motion.matches,
        saveData: (navigator as NavigatorWithConnection).connection?.saveData === true,
      });

    const showIcon = (playing: boolean) => {
      toggle.setAttribute(
        'aria-label',
        playing ? 'Pause background video' : 'Play background video',
      );
      toggle.querySelector('[data-icon=pause]')?.classList.toggle('hidden', !playing);
      toggle.querySelector('[data-icon=play]')?.classList.toggle('hidden', playing);
    };

    const play = () => {
      if (!loaded) {
        for (const source of video.querySelectorAll<HTMLSourceElement>('source[data-src]')) {
          source.src = source.dataset.src!;
        }
        video.load();
        loaded = true;
      }
      video.play().then(
        () => {
          video.dataset.playing = '';
          toggle.hidden = false;
          showIcon(true);
        },
        // Autoplay blocked or unsupported format: the poster stays, no control shown.
        () => {},
      );
    };

    const stop = () => {
      video.pause();
      delete video.dataset.playing;
      toggle.hidden = true;
    };

    const evaluate = () => {
      if (allowed()) {
        if (!pausedByUser) play();
      } else {
        stop();
      }
    };

    toggle.addEventListener('click', () => {
      if (video.paused) {
        pausedByUser = false;
        play();
      } else {
        pausedByUser = true;
        video.pause();
        showIcon(false);
      }
    });

    wide.addEventListener('change', evaluate);
    motion.addEventListener('change', evaluate);
    evaluate();
  }

  for (const hero of document.querySelectorAll<HTMLElement>('[data-video-hero]')) {
    setup(hero);
  }
</script>
