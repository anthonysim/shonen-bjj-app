---
interface Item {
  title: string;
  body: string;
}

interface Props {
  items: readonly Item[];
  /** Columns at lg. Always 1 on phones and 2 from md. */
  columns?: 2 | 3 | 4;
}

const { items, columns = 4 } = Astro.props;

const cols = {
  2: 'lg:grid-cols-2',
  3: 'lg:grid-cols-3',
  4: 'lg:grid-cols-4',
} as const;
---

<ol class:list={['grid gap-4 md:grid-cols-2 md:gap-6', cols[columns]]}>
  {items.map((item, index) => (
    // Border and text use currentColor so the card works on paper, white, and black sections
    <li class="rounded-card border border-current/20 p-6 md:p-8">
      <span aria-hidden="true" class="font-display text-3xl font-light italic opacity-60">
        {String(index + 1).padStart(2, '0')}
      </span>
      <h3 class="mt-4 text-h3">{item.title}</h3>
      <p class="mt-3 opacity-75">{item.body}</p>
    </li>
  ))}
</ol>
