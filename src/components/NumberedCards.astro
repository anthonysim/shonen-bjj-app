---
interface Item {
  title: string;
  body: string;
  /** Small label above the title, e.g. "Kids" */
  tag?: string;
  /** Makes the whole card a link */
  href?: string;
}

interface Props {
  items: readonly Item[];
  /** Columns at lg. Always 1 on phones and 2 from md. */
  columns?: 2 | 3 | 4;
}

const { items, columns = 4 } = Astro.props;

const cols = {
  2: 'lg:grid-cols-2',
  3: 'lg:grid-cols-3',
  4: 'lg:grid-cols-4',
} as const;
---

<ol class:list={['grid gap-4 md:grid-cols-2 md:gap-6', cols[columns]]}>
  {items.map((item, index) => (
    // Border and text use currentColor so the card works on paper, white, and black sections
    <li class="relative flex flex-col rounded-card border border-current/20 p-6 md:p-8">
      <span aria-hidden="true" class="font-display text-3xl font-light italic opacity-60">
        {String(index + 1).padStart(2, '0')}
      </span>
      {item.tag ? (
        <p class="mt-4 text-label font-medium tracking-[0.14em] uppercase opacity-60">{item.tag}</p>
      ) : null}
      <h3 class:list={[item.tag ? 'mt-1' : 'mt-4', 'text-h3']}>{item.title}</h3>
      <p class="mt-3 flex-1 opacity-75">{item.body}</p>
      {item.href ? (
        <a
          href={item.href}
          class="mt-5 inline-flex min-h-11 items-center gap-2 self-start border-b border-current text-nav font-medium tracking-[0.12em] uppercase after:absolute after:inset-0"
        >
          Learn more<span class="sr-only"> about {item.title}</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
      ) : null}
    </li>
  ))}
</ol>
