---
interface Props {
  items: readonly string[];
  class?: string;
}

const { items, class: className } = Astro.props;
---

<ul class:list={['flex flex-wrap gap-x-5 gap-y-2 text-sm font-semibold', className]}>
  {items.map((item) => (
    <li class="flex items-center gap-2">
      <span aria-hidden="true" class="bg-brand-500 size-1.5 rounded-full" />
      {item}
    </li>
  ))}
</ul>
