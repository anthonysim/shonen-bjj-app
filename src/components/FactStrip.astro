---
interface Props {
  items: readonly string[];
  class?: string;
}

const { items, class: className } = Astro.props;
---

<ul
  class:list={[
    'flex flex-wrap items-center gap-y-2 text-label font-medium tracking-[0.14em] uppercase',
    className,
  ]}
>
  {items.map((item) => (
    <li class="border-l border-current/30 px-4 first:border-l-0 first:pl-0">{item}</li>
  ))}
</ul>
