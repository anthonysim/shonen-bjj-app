---
// One adult track, like the original's track card: label, name, blurb, bullets, then a spec list.
// A single-category track shows "Class" and "When"; a mixed one shows a "Gi" and a "No-Gi" row.
import type { Track } from '@/data/adults';
import { friendlyWhen, schedule, type Category } from '@/data/schedule';

interface Props {
  track: Track;
}

const { track } = Astro.props;

// Resolve schedule classes in the track's own order, so times always come from the schedule
const classes = track.classIds.flatMap((id) => schedule.filter((cls) => cls.id === id));
const categories = [...new Set(classes.map((cls) => cls.category))];
const shortLabels: Record<Category, string> = { kids: 'Kids', gi: 'Gi', 'no-gi': 'No-Gi' };

const specs =
  categories.length === 1
    ? [
        ...(track.classInfo ? [{ label: 'Class', value: track.classInfo }] : []),
        { label: 'When', value: friendlyWhen(classes, { range: true }) },
      ]
    : categories.map((category) => ({
        label: shortLabels[category],
        // Like the original: start times, with an end time only for the longer Saturday class
        value: classes
          .filter((cls) => cls.category === category)
          .map((cls) => friendlyWhen([cls], { range: cls.durationMin !== 60 }))
          .join(' · '),
      }));
---

<article class="flex flex-col rounded-card border border-line bg-surface p-6 text-body md:p-10">
  <p class="text-label font-medium tracking-[0.14em] text-muted uppercase">{track.label}</p>
  <h3 class="mt-2 text-h2">{track.name}</h3>
  <p class="mt-3 text-lede">{track.blurb}</p>

  <ul class="mt-6 space-y-2">
    {track.bullets.map((bullet) => (
      <li class="flex gap-3">
        <span aria-hidden="true" class="text-muted">
          &mdash;
        </span>
        {bullet}
      </li>
    ))}
  </ul>

  <dl class="mt-auto pt-6">
    {specs.map((spec) => (
      <div class="grid grid-cols-[88px_minmax(0,1fr)] gap-4 border-t border-line py-3 text-sm leading-normal">
        <dt class="text-label leading-[1.8] font-medium tracking-[0.14em] text-muted uppercase">
          {spec.label}
        </dt>
        <dd class="text-ink">{spec.value}</dd>
      </div>
    ))}
  </dl>
</article>
