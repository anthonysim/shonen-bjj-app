---
// Small uppercase label above a heading (or inline, as a span).
interface Props {
  as?: 'p' | 'span';
  class?: string;
}

const { as: Tag = 'p', class: className } = Astro.props;
---

<Tag class:list={['text-label font-medium tracking-[0.14em] text-muted uppercase', className]}>
  <slot />
</Tag>
