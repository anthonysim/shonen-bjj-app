---
// Coach card, like the original's: photo on the left (5fr) and the bio on the right (7fr) inside one
// card on the opposite tone. Phones: square photo on top.
import coachPhoto from '@/assets/photos/untitled-1-4.webp';
import Button from '@/components/Button.astro';
import CredentialList from '@/components/CredentialList.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import Heading from '@/components/Heading.astro';
import Photo from '@/components/Photo.astro';
import Section from '@/components/Section.astro';
import { coach } from '@/data/coach';

interface Props {
  tone?: 'paper' | 'surface';
  /** Show the full bio instead of the one-line summary. */
  fullBio?: boolean;
}

const { tone = 'paper', fullBio = false } = Astro.props;
const highlights = coach.highlights;
const cardBg = tone === 'paper' ? 'bg-surface' : 'bg-paper';
---

<Section tone={tone} id="coach">
  <article
    data-reveal
    class:list={['grid overflow-hidden md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]', cardBg]}
  >
    <div class="relative aspect-square overflow-hidden bg-paper-2 md:aspect-auto md:min-h-full">
      <Photo
        src={coachPhoto}
        alt="Shonen's head instructor competing in no-gi at an IBJJF tournament"
        grade="mono"
        sizes="(min-width: 768px) 42vw, 100vw"
        widths={[480, 720, 1000]}
        class="h-full object-cover md:absolute md:inset-0"
      />
    </div>
    <div class="self-center p-[clamp(1.75rem,2rem+2vw,4.5rem)]">
      <Eyebrow>Meet the Coach</Eyebrow>
      <Heading text={coach.displayName} accent={coach.accent} class="mt-4" />
      <Eyebrow class="mt-4 text-body">{coach.title}</Eyebrow>
      {fullBio ? (
        <div class="mt-6 max-w-[60ch] space-y-4">
          {coach.bio.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
      ) : (
        <p class="mt-6 max-w-[60ch]">{coach.summary}</p>
      )}
      <CredentialList items={highlights} class="mt-8" />
      <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
        <Button href={`/team/${coach.slug}`} variant="secondary" arrow>
          {`${coach.shortName}\u2019s story`}
        </Button>
        <a
          href="#book"
          class="group inline-flex min-h-11 items-center gap-2 text-nav font-medium tracking-[0.12em] text-ink uppercase"
        >
          <span class="border-b border-line-strong pb-1 transition-colors group-hover:border-current">
            Book a class with {coach.firstName}
          </span>
          <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">
            →
          </span>
        </a>
      </div>
    </div>
  </article>
</Section>
