---
import portrait from '@/assets/placeholders/portrait.jpg';
import Button from '@/components/Button.astro';
import CredentialList from '@/components/CredentialList.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import Heading from '@/components/Heading.astro';
import Photo from '@/components/Photo.astro';
import Section from '@/components/Section.astro';
import { coach } from '@/data/coach';

interface Props {
  tone?: 'paper' | 'surface';
  /** Show the full bio instead of the one-line summary, and add a booking button. */
  fullBio?: boolean;
}

const { tone = 'surface', fullBio = false } = Astro.props;
const highlights = coach.competitionRecord.slice(0, 4);
---

<Section tone={tone} id="coach">
  <div class="grid items-center gap-8 md:grid-cols-[2fr_3fr] lg:gap-14">
    <div class="rounded-card overflow-hidden">
      <Photo
        src={portrait}
        alt={`Placeholder portrait of ${coach.name}`}
        sizes="(min-width: 768px) 40vw, 100vw"
        widths={[480, 720, 1000]}
        class="aspect-[4/5] object-cover"
      />
    </div>
    <div>
      <Eyebrow>Meet the coach</Eyebrow>
      <Heading text={coach.name} accent={coach.name.split(' ').slice(-1)[0]} class="mt-2" />
      <p class="mt-2 text-lg font-semibold">{coach.title}</p>
      {fullBio ? (
        <div class="mt-4 max-w-prose space-y-4 text-lede">
          {coach.bio.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
      ) : (
        <p class="mt-3 max-w-prose text-lede text-muted">{coach.summary}</p>
      )}
      <CredentialList items={highlights} class="mt-6" />
      <div class="mt-6 flex flex-wrap gap-3">
        <Button href={`/team/${coach.slug}`}>Meet {coach.name.split(' ')[0]}</Button>
        {fullBio ? (
          <Button href="#book" variant="secondary">
            Book a free class
          </Button>
        ) : null}
      </div>
    </div>
  </div>
</Section>
