---
import Container from '@/components/Container.astro';

interface Props {
  tone?: 'paper' | 'surface' | 'dark';
  size?: 'sm' | 'md' | 'lg';
  id?: string;
  class?: string;
  /** Extra classes for the inner Container. */
  containerClass?: string;
}

const { tone = 'paper', size = 'lg', id, class: className, containerClass } = Astro.props;

const tones = {
  paper: 'bg-paper text-body',
  surface: 'bg-surface text-body',
  // Headings read --heading, so they flip to white here
  dark: 'bg-ink text-white [--heading:#fff]',
} as const;
---

<section id={id} class:list={[tones[tone], 'py-[clamp(4.5rem,4rem+6vw,9.5rem)]', className]}>
  <Container size={size} class={containerClass}>
    <slot />
  </Container>
</section>
