---
import type { ImageMetadata } from 'astro';
import Photo from '@/components/Photo.astro';
import type { ProgramCard } from '@/data/site';

interface Props {
  card: ProgramCard;
  image: ImageMetadata;
}

const { card, image } = Astro.props;
---

<article class="group border-line bg-paper text-ink rounded-card relative flex flex-col overflow-hidden border focus-within:outline-2 focus-within:outline-offset-2 focus-within:outline-brand-600 md:flex-row">
  <div class="overflow-hidden md:w-2/5">
    <Photo
      src={image}
      alt=""
      sizes="(min-width: 768px) 40vw, 100vw"
      widths={[480, 720, 960, 1280]}
      class="aspect-[16/9] object-cover transition-transform duration-500 motion-reduce:transition-none group-hover:scale-105 md:aspect-auto md:h-full"
    />
  </div>
  <div class="flex flex-1 flex-col justify-center p-6 md:p-10">
    <p class="text-brand-600 text-xs font-semibold tracking-[0.14em] uppercase">{card.ages}</p>
    <h3 class="font-display mt-2 text-3xl font-extrabold md:text-4xl">{card.name}</h3>
    <p class="text-muted mt-2 max-w-prose text-lg">{card.blurb}</p>
    <a
      href={card.href}
      class="mt-4 inline-flex min-h-11 items-center gap-1 font-semibold after:absolute after:inset-0 focus-visible:outline-none"
    >
      Plan a party<span class="sr-only"> ({card.name})</span>
      <span aria-hidden="true">&rarr;</span>
    </a>
  </div>
</article>
