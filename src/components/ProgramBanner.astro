---
import type { ImageMetadata } from 'astro';
import Photo from '@/components/Photo.astro';
import type { ProgramCard } from '@/data/site';

interface Props {
  card: ProgramCard;
  image: ImageMetadata;
  /** Link text, e.g. "Plan a party" */
  ctaLabel?: string;
}

const { card, image, ctaLabel = 'Learn more' } = Astro.props;
---

<article class="group border-line bg-surface text-body rounded-card relative flex flex-col overflow-hidden border focus-within:outline-2 focus-within:outline-offset-2 focus-within:outline-ink md:flex-row">
  <div class="overflow-hidden md:w-2/5">
    <Photo
      src={image}
      alt=""
      sizes="(min-width: 768px) 40vw, 100vw"
      widths={[480, 720, 960, 1280]}
      class="aspect-[16/9] object-cover transition-transform duration-500 motion-reduce:transition-none group-hover:scale-105 md:aspect-auto md:h-full"
    />
  </div>
  <div class="flex flex-1 flex-col justify-center p-6 md:p-10">
    <p class="text-label font-medium tracking-[0.14em] text-muted uppercase">{card.ages}</p>
    <h3 class="mt-2 text-h2">{card.name}</h3>
    <p class="mt-3 max-w-prose text-lede">{card.blurb}</p>
    <a
      href={card.href}
      class="mt-5 inline-flex min-h-11 items-center gap-2 self-start border-b border-current text-nav font-medium tracking-[0.12em] text-ink uppercase after:absolute after:inset-0 focus-visible:outline-none"
    >
      {ctaLabel}
      <span class="sr-only"> ({card.name})</span>
      <span aria-hidden="true">&rarr;</span>
    </a>
  </div>
</article>
