---
// Inner-page hero, like the original's split hero. Phones: breadcrumbs, text, then a full-bleed
// photo. lg and up: text in columns 1-6 vertically centered, and the photo running off the right
// edge of the screen with a fade on its left side. Breadcrumbs come from BaseLayout (Astro.locals).
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Button from '@/components/Button.astro';
import FactStrip from '@/components/FactStrip.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import Heading from '@/components/Heading.astro';
import LinkArrow from '@/components/LinkArrow.astro';

interface Cta {
  label: string;
  href: string;
}

interface Props {
  eyebrow?: string;
  title: string;
  accent?: string;
  deck?: string;
  primary?: Cta;
  secondary?: Cta;
  facts?: readonly string[];
}

const { eyebrow, title, accent, deck, primary, secondary, facts } = Astro.props;
const crumbs = Astro.locals.breadcrumbs;
const hasMedia = Astro.slots.has('media');
// Distance from the content column's right edge to the screen edge (page-container's margin)
const bleed = 'max(var(--spacing-gutter), calc((100vw - 80rem) / 2))';
---

<section class="relative overflow-hidden bg-paper text-body">
  <div class="page-container grid gap-8 pt-[clamp(1.75rem,5vw,3.5rem)] lg:min-h-[min(88svh,51.25rem)] lg:grid-cols-12 lg:gap-x-[clamp(1rem,2vw,2rem)] lg:pt-0">
    <div
      class:list={[
        'relative z-[1] flex flex-col items-start pb-2 lg:col-start-1 lg:row-start-1 lg:self-center lg:py-[clamp(3rem,6vw,6rem)]',
        hasMedia ? 'lg:col-end-8 xl:col-end-7' : 'lg:col-end-10',
      ]}
    >
      {crumbs ? <Breadcrumbs crumbs={crumbs} /> : null}
      <div class:list={[crumbs && 'mt-[clamp(1.75rem,4vw,3.5rem)]']}>
        {eyebrow ? <Eyebrow class="mb-[clamp(1rem,2vw,1.5rem)]">{eyebrow}</Eyebrow> : null}
        <Heading level={1} size="xl" text={title} accent={accent} />
      </div>
      {deck ? <p class="mt-6 max-w-[56ch] text-lede">{deck}</p> : null}
      {/* Like the original: a solid button with an arrow, then a text link with an arrow */}
      {primary || secondary ? (
        <div class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-4">
          {primary ? (
            <Button href={primary.href} size="lg" arrow>
              {primary.label}
            </Button>
          ) : null}
          {secondary ? (
            <LinkArrow href={secondary.href} class="text-ink">
              {secondary.label}
            </LinkArrow>
          ) : null}
        </div>
      ) : null}
      {facts?.length ? <FactStrip items={facts} class="mt-12" /> : null}
    </div>

    {hasMedia ? (
      <div
        style={{ '--bleed': bleed }}
        class="relative -mx-(--spacing-gutter) aspect-4/5 max-h-[70svh] overflow-hidden bg-paper-2 lg:col-start-7 lg:col-end-13 lg:row-start-1 lg:mx-0 lg:mr-[calc(-1*var(--bleed))] lg:aspect-auto lg:max-h-none lg:min-h-[min(88svh,51.25rem)] lg:[mask-image:linear-gradient(90deg,transparent_0%,#000_22%)] xl:col-start-6 [&_img]:absolute [&_img]:inset-0 [&_img]:h-full [&_img]:object-cover"
      >
        <slot name="media" />
      </div>
    ) : null}
  </div>
</section>
