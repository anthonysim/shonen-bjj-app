---
// Compact rows between hairlines, like the original's .rows--compact: a small uppercase tag
// (year, event or org) on the left and the credential beside it.
interface Credential {
  title: string;
  tag: string;
}

interface Props {
  items: readonly Credential[];
  class?: string;
}

const { items, class: className } = Astro.props;
---

<ol class:list={[className]}>
  {items.map((item) => (
    <li class="grid grid-cols-[minmax(3.5rem,5rem)_minmax(0,1fr)] items-baseline gap-x-4 sm:grid-cols-[minmax(5rem,7.5rem)_minmax(0,1fr)] sm:gap-x-6 gap-y-2 border-t border-line py-4 last:border-b">
      <span class="text-label font-medium tracking-[0.14em] text-muted uppercase">{item.tag}</span>
      <span class="leading-[1.45] font-medium text-ink">{item.title}</span>
    </li>
  ))}
</ol>
