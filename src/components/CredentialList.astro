---
// Numbered rows: italic serif numeral, title, and a small tag (year, event, or org).
interface Credential {
  title: string;
  tag: string;
}

interface Props {
  items: readonly Credential[];
  class?: string;
}

const { items, class: className } = Astro.props;
---

<ol class:list={['space-y-3', className]}>
  {items.map((item, index) => (
    <li class="flex items-baseline gap-4 border-b border-line pb-3">
      <span
        aria-hidden="true"
        class="w-9 shrink-0 font-display text-2xl font-light italic opacity-60"
      >
        {String(index + 1).padStart(2, '0')}
      </span>
      <span class="flex-1 text-ink">{item.title}</span>
      <span class="text-sm font-medium text-muted">{item.tag}</span>
    </li>
  ))}
</ol>
