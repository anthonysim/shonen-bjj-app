---
import type { BreadcrumbItem } from '@/lib/structured-data';

interface Props {
  /** Full trail including Home. The last item is the current page. */
  crumbs: BreadcrumbItem[];
}

const { crumbs } = Astro.props;
---

{/* Uppercase tracked labels with slash separators, like the original */}
<nav aria-label="Breadcrumb" class="text-label font-medium tracking-[0.14em] text-muted uppercase">
  <ol class="flex flex-wrap items-center">
    {crumbs.map((crumb, index) => {
      const isLast = index === crumbs.length - 1;
      return (
        <li class="flex items-center">
          {index > 0 ? (
            <span aria-hidden="true" class="px-2.5 text-line-strong">
              /
            </span>
          ) : null}
          {crumb.href && !isLast ? (
            <a
              href={crumb.href}
              class="inline-flex min-h-11 items-center underline-offset-4 hover:text-ink hover:underline"
            >
              {crumb.label}
            </a>
          ) : (
            <span aria-current={isLast ? 'page' : undefined} class="text-body">
              {crumb.label}
            </span>
          )}
        </li>
      );
    })}
  </ol>
</nav>
