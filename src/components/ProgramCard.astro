---
import type { ImageMetadata } from 'astro';
import Photo from '@/components/Photo.astro';
import type { ProgramCard } from '@/data/site';

interface Props {
  card: ProgramCard;
  /** Zero-based position, shown as "Vol. 01" */
  index: number;
  image: ImageMetadata;
  class?: string;
}

const { card, index, image, class: className } = Astro.props;
const volume = `Vol. ${String(index + 1).padStart(2, '0')}`;
---

<article
  class:list={[
    'group relative flex h-full flex-col focus-within:outline-2 focus-within:outline-offset-4 focus-within:outline-ink',
    className,
  ]}
>
  <div class="overflow-hidden rounded-card">
    <Photo
      src={image}
      alt=""
      sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
      widths={[480, 720, 960]}
      class="aspect-[4/5] object-cover transition-transform duration-700 motion-reduce:transition-none group-hover:scale-105"
    />
  </div>
  <div class="flex flex-1 flex-col pt-5">
    <p class="text-label font-medium tracking-[0.14em] text-muted uppercase">
      {volume} · {card.ages}
    </p>
    <h3 class="mt-2 text-h3">{card.name}</h3>
    <p class="mt-2 flex-1">{card.blurb}</p>
    <a
      href={card.href}
      class="mt-5 inline-flex min-h-11 items-center gap-2 self-start border-b border-current text-nav font-medium tracking-[0.12em] text-ink uppercase after:absolute after:inset-0 focus-visible:outline-none"
    >
      Learn more<span class="sr-only"> about {card.name}</span>
      <span aria-hidden="true">&rarr;</span>
    </a>
  </div>
</article>
