---
// Program card, like the original's: the whole card is one link. 4:5 photo, "Vol. 0X" label,
// title, short text and "Learn more". Phones show only the photo, label and title.
import type { ImageMetadata } from 'astro';
import Photo from '@/components/Photo.astro';
import type { ProgramCard } from '@/data/site';

interface Props {
  card: ProgramCard;
  /** Zero-based position, shown as "Vol. 01" */
  index: number;
  image: ImageMetadata;
  class?: string;
}

const { card, index, image, class: className } = Astro.props;
const volume = `Vol. ${String(index + 1).padStart(2, '0')}`;
---

<a
  href={card.href}
  data-reveal
  style={{ '--i': index }}
  class:list={['group flex flex-col text-inherit focus-visible:outline-offset-[6px]', className]}
>
  <div class="relative aspect-4/5 overflow-hidden bg-paper-2">
    <Photo
      src={image}
      alt=""
      grade="mono"
      sizes="(min-width: 1280px) 25vw, 50vw"
      widths={[320, 480, 720, 960]}
      class="h-full object-cover transition-[filter,scale,transform] duration-300 ease-[cubic-bezier(0.22,0.61,0.36,1)] will-change-[filter,scale] motion-reduce:transition-none group-hover:scale-[1.03] group-hover:[filter:grayscale(0.15)_contrast(1.02)_brightness(1)] group-focus-visible:scale-[1.03] group-focus-visible:[filter:grayscale(0.15)_contrast(1.02)_brightness(1)] motion-reduce:group-hover:scale-100 motion-reduce:group-focus-visible:scale-100"
    />
  </div>
  <div class="flex flex-1 flex-col items-start border-b border-line py-4 sm:py-6">
    <p class="mb-2 text-[0.6875rem] font-medium tracking-[0.1em] text-muted uppercase sm:mb-3 sm:text-label sm:tracking-[0.14em]">
      {volume} · {card.ages}
    </p>
    <h3 class="text-h3 sm:mb-3">{card.name}</h3>
    <p class="mb-6 hidden flex-1 text-[0.9375rem] leading-[1.6] sm:block">{card.blurb}</p>
    <span
      aria-hidden="true"
      class="hidden items-center gap-2 border-b border-line-strong pb-1 text-nav font-medium tracking-[0.12em] text-ink uppercase transition-colors group-hover:border-current sm:inline-flex"
    >
      Learn more
      <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
    </span>
  </div>
</a>
