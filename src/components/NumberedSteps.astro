---
interface Item {
  title: string;
  body: string;
}

interface Props {
  items: readonly Item[];
}

const { items } = Astro.props;
---

<ol class="divide-y divide-current/15 border-y border-current/15">
  {items.map((item, index) => (
    <li class="flex gap-5 py-6">
      <span
        aria-hidden="true"
        class="font-display w-10 shrink-0 text-3xl font-light italic opacity-60"
      >
        {index + 1}.
      </span>
      <div>
        <h3 class="text-h3">{item.title}</h3>
        <p class="mt-2 opacity-75">{item.body}</p>
      </div>
    </li>
  ))}
</ol>
