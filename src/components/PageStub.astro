---
import Heading from '@/components/Heading.astro';
import Section from '@/components/Section.astro';

// Placeholder page body. Replaced by real content in later PRs.
interface Props {
  title: string;
  intro?: string;
}

const { title, intro } = Astro.props;
---

<Section size="md">
  <Heading level={1} size="xl" text={title} />
  {intro ? <p class="mt-4 text-base md:text-lg">{intro}</p> : null}
  <p class="text-muted mt-6">Content coming soon.</p>
</Section>
