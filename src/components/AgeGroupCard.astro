---
// One age group, like the original's .age-duo column: a photo (4:3, square from lg) sitting on
// top of a bordered card with the label, name, blurb and a class/when list at the bottom.
import type { ImageMetadata } from 'astro';
import Photo from '@/components/Photo.astro';
import type { AgeGroup } from '@/data/site';

interface Props {
  group: AgeGroup;
  image: ImageMetadata;
  /** "Tue & Thu 5:00 PM · Sat 9:00 AM" */
  when: string;
}

const { group, image, when } = Astro.props;

const specs = [
  { label: 'Class', value: [group.classLength, group.format].filter(Boolean).join(', ') },
  { label: 'When', value: when },
].filter((spec) => spec.value !== '');
---

<div data-reveal class="flex flex-col">
  <div class="aspect-4/3 overflow-hidden bg-paper-2 lg:aspect-square">
    <Photo
      src={image}
      alt=""
      grade="soft"
      sizes="(min-width: 640px) 42vw, 100vw"
      widths={[480, 720, 960]}
      class="h-full object-cover"
    />
  </div>
  <article
    id={group.id}
    class="flex flex-1 scroll-mt-6 flex-col rounded-b-card border border-t-0 border-line-strong p-[clamp(1.5rem,3vw,2.5rem)]"
  >
    <p class="text-label font-medium tracking-[0.14em] text-muted uppercase">{group.ages}</p>
    <h3 class="mt-3 text-h3">{group.name}</h3>
    <p class="mt-4">{group.description}</p>
    <dl class="mt-auto pt-8">
      {specs.map((spec) => (
        <div class="grid grid-cols-[5.5rem_minmax(0,1fr)] gap-4 border-t border-line py-3 text-sm leading-normal">
          <dt class="text-label leading-[1.8] font-medium tracking-[0.14em] text-muted uppercase">
            {spec.label}
          </dt>
          <dd class="text-ink">{spec.value}</dd>
        </div>
      ))}
    </dl>
  </article>
</div>
