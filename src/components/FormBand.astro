---
import BookingForm from '@/components/BookingForm.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import Heading from '@/components/Heading.astro';
import Section from '@/components/Section.astro';
import { site } from '@/data/site';
import type { ProgramChoice } from '@/lib/booking-schema';

interface Props {
  /** Small label above the heading */
  eyebrow?: string;
  heading?: string;
  accent?: string;
  body?: string;
  /** Short selling points shown beside the form. */
  bullets?: readonly string[];
  submitLabel?: string;
  defaultProgram?: ProgramChoice;
  /** Section id, so "Book a free class" buttons can link to #book. */
  id?: string;
}

// Defaults are the original's trial band copy
const {
  eyebrow = 'Your first class is free',
  heading = 'Your journey starts here.',
  accent = 'starts here.',
  body = "Pick a program and we'll text you to lock in a time. Every class on the schedule is open to first-timers, and a clean gi is waiting for you.",
  bullets = [
    'No sign-up fees, ever',
    'No experience or fitness needed',
    'Taught by an IBJJF black belt',
  ],
  submitLabel,
  defaultProgram,
  id = 'book',
} = Astro.props;
---

<Section tone="dark" id={id}>
  {/* Like the original's trial band: text in columns 1-5 (sticky on desktop), form card in 7-12 */}
  <div class="grid items-start gap-12 lg:grid-cols-12 lg:gap-x-[clamp(1rem,2vw,2rem)]">
    <div class="lg:sticky lg:top-[7.5rem] lg:col-span-5 lg:pt-4">
      {eyebrow ? <Eyebrow class="mb-4 text-white/55">{eyebrow}</Eyebrow> : null}
      <Heading text={heading} accent={accent} size="lg" class="max-w-[12em]" />
      <p class="mt-6 max-w-prose text-lede text-white/72">{body}</p>
      {bullets.length > 0 ? (
        <ul class="mt-8 border-t border-white/16">
          {bullets.map((bullet) => (
            <li class="flex gap-3.5 border-b border-white/16 py-3.5 text-white">
              <span aria-hidden="true" class="text-white/55">
                &mdash;
              </span>
              {bullet}
            </li>
          ))}
        </ul>
      ) : null}
      <div class="mt-6 text-white/72">
        {Astro.slots.has('default') ? (
          <slot />
        ) : (
          <p>
            Prefer to talk?{' '}
            <a
              href={site.phone.href}
              class="text-white underline decoration-white/36 underline-offset-4 hover:decoration-current"
            >
              {site.phone.display}
            </a>
          </p>
        )}
      </div>
    </div>
    <div class="relative rounded-card bg-surface p-[clamp(1.5rem,3vw,2.75rem)] text-body shadow-[0_18px_50px_-20px_rgb(0_0_0/0.25)] [--heading:var(--color-ink)] lg:col-span-6 lg:col-start-7">
      <BookingForm submitLabel={submitLabel} defaultProgram={defaultProgram} idPrefix={id} />
    </div>
  </div>
</Section>
