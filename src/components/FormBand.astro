---
import BookingForm from '@/components/BookingForm.astro';
import Heading from '@/components/Heading.astro';
import Section from '@/components/Section.astro';
import type { ProgramChoice } from '@/lib/booking-schema';

interface Props {
  heading?: string;
  accent?: string;
  body?: string;
  /** Short selling points shown beside the form. */
  bullets?: readonly string[];
  submitLabel?: string;
  defaultProgram?: ProgramChoice;
  /** Section id, so "Book a free class" buttons can link to #book. */
  id?: string;
}

const {
  heading = 'Book your free class',
  accent = 'free',
  body = 'Tell us a little about you and we will text you to set a time.',
  bullets = ['First class is free', 'No sign-up fees', 'Gear provided for your first class'],
  submitLabel,
  defaultProgram,
  id = 'book',
} = Astro.props;
---

<Section tone="dark" id={id}>
  {/* Like the original's trial band: text in columns 1-5 (sticky on desktop), form card in 7-12 */}
  <div class="grid items-start gap-12 lg:grid-cols-12 lg:gap-x-[clamp(16px,2vw,32px)]">
    <div class="lg:sticky lg:top-[120px] lg:col-span-5 lg:pt-4">
      <Heading text={heading} accent={accent} size="lg" class="max-w-[12em]" />
      <p class="mt-6 max-w-prose text-lede text-white/72">{body}</p>
      {bullets.length > 0 ? (
        <ul class="mt-8 border-t border-white/16">
          {bullets.map((bullet) => (
            <li class="flex gap-3.5 border-b border-white/16 py-3.5 text-white">
              <span aria-hidden="true" class="text-white/55">
                &mdash;
              </span>
              {bullet}
            </li>
          ))}
        </ul>
      ) : null}
      <div class="mt-6 text-white/72">
        <slot />
      </div>
    </div>
    <div class="relative rounded-card bg-surface p-[clamp(24px,3vw,44px)] text-body shadow-[0_18px_50px_-20px_rgb(0_0_0/0.25)] [--heading:var(--color-ink)] lg:col-span-6 lg:col-start-7">
      <BookingForm submitLabel={submitLabel} defaultProgram={defaultProgram} idPrefix={id} />
    </div>
  </div>
</Section>
