---
// Reviews, like the original's: a split header with the rating summary on the right, then one large
// featured quote (sticky on desktop) beside the rest stacked between hairlines. On phones the
// quotes become a swipeable row of cards. A single review shows as one centered featured quote.
import Eyebrow from '@/components/Eyebrow.astro';
import Section from '@/components/Section.astro';
import SectionHead from '@/components/SectionHead.astro';
import { rating, reviewLabel, type Review } from '@/data/reviews';

interface Props {
  reviews: readonly Review[];
  heading?: string;
  accent?: string;
  eyebrow?: string;
  tone?: 'paper' | 'surface';
}

const {
  reviews,
  heading = 'What students say',
  accent = 'say',
  eyebrow = 'Reviews',
  tone = 'surface',
} = Astro.props;

const [feature, ...rest] = reviews;
const single = rest.length === 0;
// One string so formatters can't split the expressions and drop the space between them
const reviewCount = `${rating.count} ${rating.source}`;
const readAll = `Read all ${rating.count} reviews on ${rating.source}`;
// Cards on phones sit on the opposite tone so they read as cards
const cardBg = tone === 'surface' ? 'max-lg:bg-paper' : 'max-lg:bg-surface';
---

<Section tone={tone}>
  <SectionHead eyebrow={eyebrow} heading={heading} accent={accent}>
    <Fragment slot="aside">
      <p class="inline-flex flex-wrap items-baseline gap-x-3.5 gap-y-1.5 text-sm">
        <span class="font-display text-[2rem] leading-none font-light text-ink">
          {rating.score.toFixed(1)}
        </span>
        <span aria-hidden="true" class="text-[0.9375rem] tracking-[0.18em] text-ink">
          ★★★★★
        </span>
        <span>{reviewCount} reviews</span>
      </p>
      <a
        href={rating.url}
        rel="noopener"
        class="group inline-flex min-h-11 items-center gap-2 text-nav font-medium tracking-[0.12em] text-ink uppercase"
      >
        <span class="border-b border-line-strong pb-1 transition-colors group-hover:border-current">
          {readAll}
        </span>
        <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">
          →
        </span>
      </a>
    </Fragment>
  </SectionHead>

  {single ? (
    <figure class="mx-auto max-w-3xl text-center">
      <blockquote>
        <p class="font-display text-[clamp(1.75rem,1.2rem+2.1vw,3.125rem)] leading-[1.14] font-light tracking-[-0.015em] text-balance text-ink">
          &ldquo;{feature.quote}&rdquo;
        </p>
      </blockquote>
      <figcaption class="mt-8 flex flex-wrap items-baseline justify-center gap-x-3 gap-y-1">
        <span class="text-[0.9375rem] font-medium text-ink">{feature.author}</span>
        <Eyebrow as="span">{reviewLabel(feature)}</Eyebrow>
      </figcaption>
    </figure>
  ) : (
    <div class="-mx-(--spacing-gutter) grid snap-x snap-mandatory auto-cols-[85%] grid-flow-col gap-3 overflow-x-auto scroll-px-(--spacing-gutter) px-(--spacing-gutter) pb-4 lg:mx-0 lg:snap-none lg:grid-flow-row lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:items-start lg:gap-x-[clamp(32px,6vw,112px)] lg:gap-y-0 lg:overflow-visible lg:p-0">
      <figure
        class:list={[
          'flex snap-start flex-col justify-between rounded-card border border-line p-6 lg:sticky lg:top-[calc(var(--spacing-header)+48px)] lg:col-start-1 lg:row-span-3 lg:row-start-1 lg:rounded-none lg:border-0 lg:bg-transparent lg:p-0',
          cardBg,
        ]}
      >
        <blockquote>
          <p class="-indent-[0.42em] font-display text-2xl leading-tight font-light tracking-[-0.015em] text-balance text-ink lg:text-[clamp(1.75rem,1.2rem+2.1vw,3.125rem)] lg:leading-[1.14]">
            &ldquo;{feature.quote}&rdquo;
          </p>
        </blockquote>
        <figcaption class="mt-6 flex flex-wrap items-baseline gap-x-3 gap-y-1 lg:mt-8">
          <span class="text-[0.9375rem] font-medium text-ink">{feature.author}</span>
          <Eyebrow as="span">{reviewLabel(feature)}</Eyebrow>
        </figcaption>
      </figure>
      {rest.map((review) => (
        <figure
          class:list={[
            'flex snap-start flex-col justify-between rounded-card border border-line p-6 lg:col-start-2 lg:rounded-none lg:border-x-0 lg:border-b-0 lg:bg-transparent lg:px-0 lg:py-8 lg:last:border-b',
            cardBg,
          ]}
        >
          <blockquote>
            <p class="font-display text-[clamp(1.125rem,1.07rem+0.25vw,1.25rem)] leading-[1.45] font-light text-pretty italic">
              &ldquo;{review.quote}&rdquo;
            </p>
          </blockquote>
          <figcaption class="mt-6 flex flex-wrap items-baseline gap-x-3 gap-y-1">
            <span class="text-[0.9375rem] font-medium text-ink">{review.author}</span>
            <Eyebrow as="span">{reviewLabel(review)}</Eyebrow>
          </figcaption>
        </figure>
      ))}
    </div>
  )}
</Section>
