---
// A one-line program link between hairlines: thumbnail, label and title, then an arrow. Like the
// original's birthday-parties row under the program cards.
import type { ImageMetadata } from 'astro';
import Photo from '@/components/Photo.astro';

interface Props {
  href: string;
  label: string;
  title: string;
  accent?: string;
  image: ImageMetadata;
  class?: string;
}

const { href, label, title, accent, image, class: className } = Astro.props;
const at = accent ? title.lastIndexOf(accent) : -1;
---

<a
  href={href}
  data-reveal
  class:list={[
    'group grid grid-cols-[7.5rem_minmax(0,1fr)_auto] items-center gap-x-[clamp(1rem,3vw,2.5rem)] gap-y-4 border-y border-line py-4 text-inherit sm:grid-cols-[13.75rem_minmax(0,1fr)_auto]',
    className,
  ]}
>
  <div class="aspect-3/2 overflow-hidden bg-paper-2">
    <Photo
      src={image}
      alt=""
      grade="mono"
      sizes="(min-width: 1536px) 15vw, 220px"
      widths={[240, 440, 800]}
      class="h-full object-cover transition-[filter,transform] duration-[1200ms] motion-reduce:transition-none group-hover:scale-[1.03] group-hover:[filter:grayscale(0.15)_contrast(1.02)] motion-reduce:group-hover:scale-100"
    />
  </div>
  <div>
    <p class="text-label font-medium tracking-[0.14em] text-muted uppercase">{label}</p>
    <h3 class="mt-2 font-display text-[clamp(1.25rem,1.05rem+1.1vw,2.25rem)] leading-tight font-light text-ink">
      {at > 0 ? (
        <>
          {title.slice(0, at)}
          <em class="italic">{title.slice(at)}</em>
        </>
      ) : (
        title
      )}
    </h3>
  </div>
  <span
    aria-hidden="true"
    class="text-2xl leading-none transition-transform group-hover:translate-x-1"
  >
    →
  </span>
</a>
