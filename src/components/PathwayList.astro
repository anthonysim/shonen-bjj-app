---
import type { PathwayStage } from '@/data/academy';

interface Props {
  stages: readonly PathwayStage[];
}

const { stages } = Astro.props;
---

<ol class="border-line divide-line divide-y border-y">
  {stages.map((stage, index) => (
    <li class="relative flex items-start gap-4 py-6 md:items-center md:gap-8">
      <span
        aria-hidden="true"
        class="font-display w-12 shrink-0 text-3xl font-light italic opacity-60 md:w-16 md:text-4xl"
      >
        {String(index + 1).padStart(2, '0')}
      </span>
      <div class="flex-1">
        <h3 class="text-h3">{stage.title}</h3>
        <p class="text-muted mt-1 max-w-prose">{stage.body}</p>
      </div>
      <a
        href={stage.href}
        class="inline-flex min-h-11 shrink-0 items-center gap-1 self-center text-nav font-medium tracking-[0.12em] uppercase after:absolute after:inset-0"
      >
        <span class="max-md:sr-only">Explore</span>
        <span class="sr-only md:hidden"> {stage.title}</span>
        <span aria-hidden="true">&rarr;</span>
      </a>
    </li>
  ))}
</ol>
