---
// Renders <a> when `href` is set, otherwise <button>. 44px minimum tap target.
interface Props {
  variant?: 'primary' | 'secondary' | 'ghost' | 'inverse';
  size?: 'md' | 'lg';
  href?: string;
  /** Only applies when rendered as a link. */
  rel?: string;
  type?: 'button' | 'submit' | 'reset';
  /** Only applies when rendered as a <button>. */
  disabled?: boolean;
  class?: string;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  rel,
  type = 'button',
  disabled,
  class: className,
  ...rest
} = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2 rounded-md font-semibold transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-500 disabled:opacity-50';

const variants = {
  primary: 'bg-brand-600 text-white hover:bg-brand-700',
  secondary: 'border border-current bg-transparent hover:bg-black/5',
  ghost: 'bg-transparent underline-offset-4 hover:underline',
  // For dark and brand-colored sections where the red primary would disappear
  inverse: 'bg-white text-brand-700 hover:bg-brand-50',
} as const;

const sizes = {
  md: 'min-h-11 px-4 text-base',
  lg: 'min-h-14 px-6 text-lg',
} as const;

const classes = [base, variants[variant], sizes[size], className];
---

{href ? (
  <a href={href} rel={rel} class:list={classes} {...rest}>
    <slot />
  </a>
) : (
  <button type={type} disabled={disabled} class:list={classes} {...rest}>
    <slot />
  </button>
)}
