---
// Renders <a> when `href` is set, otherwise <button>. Uppercase, tracked, near-square.
interface Props {
  variant?: 'primary' | 'secondary' | 'ghost' | 'inverse';
  size?: 'md' | 'lg';
  href?: string;
  /** Only applies when rendered as a link. */
  rel?: string;
  type?: 'button' | 'submit' | 'reset';
  /** Only applies when rendered as a <button>. */
  disabled?: boolean;
  /** Trailing arrow, for primary calls to action. */
  arrow?: boolean;
  class?: string;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  rel,
  type = 'button',
  disabled,
  arrow = false,
  class: className,
  ...rest
} = Astro.props;

const base =
  'group/btn inline-flex items-center justify-center gap-2.5 rounded-card border text-nav font-medium tracking-[0.12em] whitespace-nowrap uppercase transition-colors disabled:opacity-50';

const variants = {
  primary: 'border-ink bg-ink text-white hover:bg-body hover:border-body',
  secondary: 'border-current/30 bg-transparent hover:border-current',
  ghost: 'border-transparent bg-transparent underline-offset-4 hover:underline',
  // For dark sections, where the black primary would disappear
  inverse: 'border-white bg-white text-ink hover:bg-paper-2 hover:border-paper-2',
} as const;

const sizes = {
  md: 'min-h-12 px-6',
  lg: 'min-h-12 px-7 md:min-h-[3.25rem]',
} as const;

const classes = [base, variants[variant], sizes[size], className];
---

{href ? (
  <a href={href} rel={rel} class:list={classes} {...rest}>
    <slot />
    {arrow ? (
      <span aria-hidden="true" class="transition-transform group-hover/btn:translate-x-1">
        &rarr;
      </span>
    ) : null}
  </a>
) : (
  <button type={type} disabled={disabled} class:list={classes} {...rest}>
    <slot />
    {arrow ? (
      <span aria-hidden="true" class="transition-transform group-hover/btn:translate-x-1">
        &rarr;
      </span>
    ) : null}
  </button>
)}
