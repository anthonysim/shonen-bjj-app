---
import SiteNav from '@/components/SiteNav';
import { nav, site } from '@/data/site';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="sticky top-0 z-30 border-b border-line bg-paper/95 backdrop-blur">
  <div class="relative mx-auto flex h-16 max-w-[1280px] items-center justify-between gap-2 px-[clamp(1.25rem,4vw,3rem)]">
    <a
      href="/"
      class="focus-visible:outline-ink inline-flex min-h-11 items-center font-display text-xl font-light whitespace-nowrap italic tracking-tight sm:text-2xl focus-visible:outline-2 focus-visible:outline-offset-2"
    >
      {site.name}
    </a>
    <SiteNav client:load nav={nav} cta={site.cta} phone={site.phone} currentPath={currentPath} />
  </div>
</header>
