---
import SiteNav from '@/components/SiteNav';
import { nav, site } from '@/data/site';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="sticky top-0 z-30 border-b border-black/10 bg-white/95 backdrop-blur">
  <div class="relative mx-auto flex h-16 max-w-6xl items-center justify-between gap-2 px-4 md:px-8">
    <a
      href="/"
      class="focus-visible:outline-brand-600 inline-flex min-h-11 items-center text-lg font-bold tracking-tight focus-visible:outline-2 focus-visible:outline-offset-2"
    >
      {site.name}
    </a>
    <SiteNav client:load nav={nav} cta={site.cta} phone={site.phone} currentPath={currentPath} />
  </div>
</header>
