---
// Site header, laid out like the original: wordmark left, nav centered, phone and CTA right.
// The 1fr auto 1fr grid keeps the nav centered no matter how wide the sides are, so nothing in
// the header moves between pages. Below lg the nav collapses into MobileMenu.
//
// `overlay` (homepage) floats the header over the dark hero: transparent with white text until the
// page scrolls, then the usual paper bar. States live in global.css under `.site-header`.
import MobileMenu from '@/components/MobileMenu';
import { nav, site } from '@/data/site';

interface Props {
  overlay?: boolean;
}

const { overlay = false } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => currentPath === href || currentPath.startsWith(`${href}/`);
const desktopNav = nav.filter((item) => !item.mobileOnly);
---

<header id="site-header" class="site-header" data-header data-overlay={overlay ? '' : undefined}>
  <div class="page-container grid h-full grid-cols-[1fr_auto] items-center gap-6 lg:grid-cols-[1fr_auto_1fr]">
    <a
      href="/"
      class="inline-flex items-center justify-self-start py-2 font-display text-2xl font-light whitespace-nowrap italic tracking-tight lg:text-[1.75rem]"
    >
      {site.name}
    </a>

    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-[clamp(1.25rem,2.2vw,2.25rem)]">
        {desktopNav.map((item) =>
          item.children?.length ? (
            <li class="site-nav__group relative" data-nav-dropdown>
              <button
                type="button"
                class="site-nav__link inline-flex cursor-pointer items-center gap-1.5"
                aria-expanded="false"
                aria-haspopup="true"
                data-nav-trigger
                data-active={isActive(item.href) ? '' : undefined}
              >
                {item.label}
                <svg
                  aria-hidden="true"
                  viewBox="0 0 12 12"
                  class="site-nav__chevron size-2.5 opacity-65 transition-transform duration-300"
                  fill="none"
                >
                  <path
                    d="M2.25 4.5 6 8.25 9.75 4.5"
                    stroke="currentColor"
                    stroke-width="1.35"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </button>
              <div class="site-nav__dropdown" data-nav-panel hidden>
                <ul class="divide-y divide-line">
                  {item.children.map((child) => (
                    <li>
                      <a
                        href={child.href}
                        aria-current={currentPath === child.href ? 'page' : undefined}
                        class="flex items-baseline justify-between gap-6 px-4 py-3 text-sm text-ink transition-colors hover:bg-paper-2/70 aria-[current=page]:font-medium"
                      >
                        <span>{child.label}</span>
                        {child.detail ? (
                          <span class="text-label tracking-[0.08em] text-muted uppercase">
                            {child.detail}
                          </span>
                        ) : null}
                      </a>
                    </li>
                  ))}
                  <li>
                    <a
                      href={item.href}
                      aria-current={currentPath === item.href ? 'page' : undefined}
                      class="flex items-center justify-between gap-4 bg-paper-2/40 px-4 py-2.5 text-label font-medium tracking-[0.12em] text-ink uppercase transition-colors hover:bg-paper-2"
                    >
                      <span>Compare all programs</span>
                      <span aria-hidden="true">&rarr;</span>
                    </a>
                  </li>
                </ul>
              </div>
            </li>
          ) : (
            <li>
              <a
                href={item.href}
                class="site-nav__link"
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ),
        )}
      </ul>
    </nav>

    <div class="flex items-center gap-6 justify-self-end">
      <a
        href={site.phone.href}
        class="hidden text-nav font-medium tracking-[0.06em] whitespace-nowrap opacity-85 transition-opacity duration-300 hover:underline hover:underline-offset-4 hover:opacity-100 min-[1100px]:inline"
      >
        {site.phone.display}
      </a>
      <a href={site.cta.href} class="site-header__cta hidden lg:inline-flex">
        {site.cta.label}
      </a>
      <MobileMenu
        client:load
        nav={nav}
        cta={site.cta}
        phone={site.phone}
        currentPath={currentPath}
      />
    </div>
  </div>
</header>

{overlay ? (
  /* Inline so a page reloaded mid-scroll gets the solid bar before first paint */
  <script is:inline>
    (() => {
      const header = document.getElementById('site-header');
      let ticking = false;
      const update = () => {
        ticking = false;
        header.toggleAttribute('data-scrolled', window.scrollY > 24);
      };
      window.addEventListener(
        'scroll',
        () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(update);
        },
        { passive: true },
      );
      update();
    })();
  </script>
) : null}

<script>
  const groups = document.querySelectorAll<HTMLElement>('[data-nav-dropdown]');

  for (const group of groups) {
    const trigger = group.querySelector<HTMLButtonElement>('[data-nav-trigger]');
    const panel = group.querySelector<HTMLElement>('[data-nav-panel]');
    if (!trigger || !panel) continue;

    const setOpen = (open: boolean) => {
      trigger.setAttribute('aria-expanded', String(open));
      group.toggleAttribute('data-open', open);
      panel.hidden = !open;
    };

    trigger.addEventListener('click', (event) => {
      event.stopPropagation();
      const next = trigger.getAttribute('aria-expanded') !== 'true';
      setOpen(next);
    });

    document.addEventListener('click', (event) => {
      if (trigger.getAttribute('aria-expanded') !== 'true') return;
      if (event.target instanceof Node && !group.contains(event.target)) {
        setOpen(false);
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || trigger.getAttribute('aria-expanded') !== 'true') return;
      setOpen(false);
      trigger.focus();
    });
  }
</script>
