---
// Dictionary-style entry for a word. Used for the academy's name story.
interface Props {
  word: string;
  pronunciation?: string;
  partOfSpeech?: string;
  meaning: string;
}

const { word, pronunciation, partOfSpeech, meaning } = Astro.props;
---

<div>
  <Fragment>
    <p class="text-label font-medium tracking-[0.14em] text-muted uppercase">Definition</p>
    <div class="mt-3 flex flex-wrap items-baseline gap-x-5 gap-y-1 border-b border-line-strong pb-5">
      <p class="font-display text-h1 font-light text-ink">{word}</p>
      {pronunciation || partOfSpeech ? (
        <p class="text-label font-medium tracking-[0.14em] text-muted uppercase">
          {pronunciation ? <span>/ {pronunciation} /</span> : null}
          {pronunciation && partOfSpeech ? <span aria-hidden="true"> · </span> : null}
          {partOfSpeech ? <span>{partOfSpeech}</span> : null}
        </p>
      ) : null}
    </div>
    <p class="mt-5 text-lede text-ink">
      <span aria-hidden="true" class="font-display mr-2 font-light italic text-muted">
        1.
      </span>
      {meaning}
    </p>
  </Fragment>
</div>
