---
// Dictionary-style entry for the academy's name, like the original's .definition: a "Definition"
// label, the word at display size, the pronunciation and part of speech, then the meaning under a
// hairline. Homepage and About.
interface Props {
  word: string;
  pronunciation?: string;
  partOfSpeech?: string;
  meaning: string;
  class?: string;
}

const { word, pronunciation, partOfSpeech, meaning, class: className } = Astro.props;
const phonetic = [pronunciation && `/ ${pronunciation} /`, partOfSpeech]
  .filter(Boolean)
  .join(' · ');
const label = 'text-label font-medium tracking-[0.14em] text-muted uppercase';
---

<div class:list={['grid gap-3', className]}>
  <p class={label}>Definition</p>
  <p class="font-display text-display font-light text-ink">{word}</p>
  {phonetic ? <p class={label}>{phonetic}</p> : null}
  <p class="mt-3 max-w-[52ch] border-t border-line pt-6 text-lede">{meaning}</p>
</div>
