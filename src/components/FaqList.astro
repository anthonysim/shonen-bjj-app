---
import { answerParts } from '@/data/faqs';

// Questions as native <details>, like the original's .faq: hairline rows, a sans question, and a
// thin plus that turns into an x when open. Items sharing `name` open one at a time. No JS.
interface Item {
  question: string;
  answer: string;
  /** Optional bullet list shown under the answer (e.g. etiquette rules). */
  list?: readonly string[];
}

interface Props {
  items: readonly Item[];
  /** Exclusive-accordion group name: opening one question closes the others with the same name. */
  name?: string;
}

const { items, name = 'faq' } = Astro.props;
---

<div class="faq border-t border-line">
  {items.map((item) => (
    <details name={name} class="group border-b border-line">
      <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-6 py-6 text-left [&::-webkit-details-marker]:hidden">
        <span class="text-[clamp(1.0625rem,1rem+0.3vw,1.25rem)] leading-[1.35] font-medium tracking-[-0.005em] text-ink decoration-line-strong underline-offset-[5px] group-hover:underline">
          {item.question}
        </span>
        <span
          aria-hidden="true"
          class="relative size-4 flex-none transition-transform duration-300 group-open:rotate-45 before:absolute before:top-1/2 before:left-0 before:h-px before:w-full before:bg-ink after:absolute after:top-1/2 after:left-0 after:h-px after:w-full after:rotate-90 after:bg-ink"
        />
      </summary>
      <div class="max-w-[64ch] space-y-4 pb-8">
        {answerParts(item.answer).map((paragraph) => (
          <p>
            {paragraph.map((part) =>
              part.href ? (
                <a href={part.href} class="text-ink underline underline-offset-4">
                  {part.text}
                </a>
              ) : (
                part.text
              ),
            )}
          </p>
        ))}
        {item.list?.length ? (
          <ul class="space-y-2">
            {item.list.map((entry) => (
              <li class="relative pl-6 before:absolute before:left-0 before:text-muted before:content-['—']">
                {entry}
              </li>
            ))}
          </ul>
        ) : null}
      </div>
    </details>
  ))}
</div>
