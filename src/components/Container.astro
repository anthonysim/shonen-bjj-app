---
// Centered, padded content column. Mobile-first gutters.
interface Props {
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}

const { size = 'lg', class: className } = Astro.props;

const sizes = {
  sm: 'max-w-2xl',
  md: 'max-w-4xl',
  lg: 'max-w-[1280px]',
} as const;
---

<div class:list={['mx-auto w-full px-[clamp(1.25rem,4vw,3rem)]', sizes[size], className]}>
  <slot />
</div>
