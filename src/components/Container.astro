---
// Centered content column with the site gutters (see page-container in global.css).
interface Props {
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}

const { size = 'lg', class: className } = Astro.props;

// Content widths; page-container adds the gutters outside them
const sizes = {
  sm: '[--page-max:42rem]',
  md: '[--page-max:56rem]',
  lg: '',
} as const;
---

<div class:list={['page-container', sizes[size], className]}>
  <slot />
</div>
