# Placeholders only. Real values go in .env.local (never committed) and in Vercel.

# Free-class form: lead emails via Resend (https://resend.com). Required in production;
# without them the form logs leads in dev and shows an error in production.
# RESEND_API_KEY=re_xxxxxxxx
# LEAD_TO_EMAIL=info@shonenjiujitsu.com
# LEAD_FROM_EMAIL="Shonen Jiu Jitsu <leads@shonenjiujitsu.com>"

# Optional spam check with Cloudflare Turnstile. Set both to turn it on.
# PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Production site URL (canonical links, sitemap, structured data)
# SITE_URL=https://www.shonenjiujitsu.com
